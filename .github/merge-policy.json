{
  "schema": "merge-policy/v1",
  "ci_workflows": [
    {
      "file": "vpngw-ci.yml",
      "paths": [
        "services/vpngw/**",
        ".github/workflows/vpngw-ci.yml",
        ".github/workflows/vpngw-release.yml",
        "skills/github-workflows/scripts/publication.py",
        "skills/github-workflows/scripts/release_qualification.py",
        "skills/publish-release/scripts/**",
        ".github/merge-policy.json"
      ]
    },
    {
      "file": "nebius-cxcli-ci.yml",
      "paths": [
        ".github/helm-chart-publish.json",
        "services/nebius-cxcli/**",
        "services/nccl-test/**",
        "helm-charts/nccl-test/**",
        "platform-infra/modules/**",
        ".github/workflows/nebius-cxcli-ci.yml",
        ".github/workflows/nebius-cxcli-release.yml",
        "skills/github-workflows/scripts/publication.py",
        "skills/github-workflows/scripts/release_qualification.py",
        "skills/publish-release/scripts/**",
        ".github/merge-policy.json"
      ]
    },
    {
      "file": "nebius-cxcli-nsight.yml",
      "paths": [
        "services/nebius-cxcli/src/nebius_cxcli/nsight*.py",
        "services/nebius-cxcli/src/nebius_cxcli/flux_render.py",
        "services/nebius-cxcli/scripts/verify_nsight*.py",
        "services/nebius-cxcli/tests/test_nsight*.py",
        ".github/workflows/nebius-cxcli-nsight.yml",
        "services/nebius-cxcli/pyproject.toml",
        "services/nebius-cxcli/uv.lock"
      ]
    },
    {
      "file": "skills-project-specs-ci.yml",
      "paths": [
        "skills/**",
        ".github/workflows/skills-project-specs-ci.yml",
        ".github/scripts/run_unittest_shard.py",
        ".github/scripts/test_ci_parallelism.py",
        ".agents/plugins/marketplace.json",
        ".claude-plugin/marketplace.json"
      ]
    },
    {
      "file": "courses-ci.yml",
      "paths": [
        "courses/**",
        ".github/workflows/courses-ci.yml"
      ]
    },
    {
      "file": "merge-automation-ci.yml",
      "paths": [
        "**"
      ]
    },
    {
      "file": "ai-support-agent-ci.yml",
      "paths": [
        "agents/ai-support-agent/**",
        ".github/workflows/ai-support-agent-ci.yml",
        "README.md"
      ]
    },
    {
      "file": "github-ai-automation-ci.yml",
      "paths": [
        "github-ai-automation/**",
        ".github/workflows/github-ai-*.yml",
        "skills/merge-pr/scripts/candidate_ci.py"
      ]
    }
  ],
  "merge_workflow": "skills-merge-pr.yml",
  "completion_workflow": "merge-completion.yml",
  "pages_enabled": true,
  "status_workflow": "ci-status-observer.yml",
  "release_profiles": {
    "services/vpngw": {
      "publisher": "vpngw-release.yml",
      "workflows": {
        "vpngw-ci.yml": {
          "jobs": {
            "ordinary-job-settlement": [
              "Ordinary systemd and networkd settlement"
            ],
            "historical-package-upgrades": [
              "Authentic release package upgrades"
            ],
            "lint": [
              "lint"
            ],
            "unit-tests": [
              "unit-tests"
            ],
            "build": [
              "build"
            ]
          },
          "reports": [
            {
              "name": "vpngw-native-{attempt}",
              "contract": "native-cases/v1"
            },
            {
              "name": "vpngw-package-history-{attempt}",
              "contract": "package-history/v1"
            }
          ]
        },
        "merge-automation-ci.yml": {
          "jobs": {
            "contracts": [
              "contracts"
            ]
          }
        }
      }
    },
    "services/nebius-cxcli": {
      "publisher": "nebius-cxcli-release.yml",
      "workflows": {
        "nebius-cxcli-ci.yml": {
          "jobs": {
            "python-compatibility": [
              "Python 3.12 offline suite",
              "Python 3.13 offline suite",
              "Python 3.14 offline suite"
            ],
            "verify": [
              "Quality, coverage, and wheel"
            ],
            "wheel-compatibility": [
              "Python 3.12 exact wheel contract",
              "Python 3.13 exact wheel contract",
              "Python 3.14 exact wheel contract"
            ]
          }
        },
        "nebius-cxcli-nsight.yml": {
          "jobs": {
            "native-packages": [
              "Nsight Ubuntu 22.04 native amd64",
              "Nsight Ubuntu 22.04 native arm64",
              "Nsight Ubuntu 24.04 native amd64",
              "Nsight Ubuntu 24.04 native arm64"
            ],
            "official-chart": [
              "official-chart"
            ]
          }
        },
        "merge-automation-ci.yml": {
          "jobs": {
            "contracts": [
              "contracts"
            ]
          }
        }
      }
    }
  }
}
