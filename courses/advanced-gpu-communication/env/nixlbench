#!/usr/bin/env bash
set -euo pipefail
: "${COURSE_NIXL_PREFIX:?run course setup}"
: "${COURSE_NIXLBENCH_BINARY:?run course setup}"
: "${UCX_PREFIX:?prepared standalone UCX prefix}"
# Scope standalone transport libraries to this child, never Dynamo's environment.
export LD_LIBRARY_PATH="$COURSE_NIXL_PREFIX/lib:$COURSE_NIXL_PREFIX/lib/plugins:$UCX_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
exec "$COURSE_NIXLBENCH_BINARY" "$@"
