{
  "uid": "course-557da2346ee4fb9f2ce243aa",
  "title": "Lab 06: Compare copy engines and SM peer traffic",
  "tags": [
    "gpu-course",
    "advanced-gpu-communication",
    "06_nvlink_bandwidth"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "description": "Compare the slowest pair and mean bandwidth, then open the private vendor JSON and locate asymmetric pairs in bandwidth_matrix. A CE-versus-SM difference is a mechanism study; decide which resource your application can spare. Independently repeat the same engine three times. Keep buffer size and sample count fixed. H100 inter-node InfiniBand is not nvbandwidth multi-node NVLink/IMEX; this lab intentionally stays within one worker. Use unprofiled artifact summaries for comparison. Systems explains CUDA execution and host submission; sampled device telemetry supplies context. Correctness/mechanics exercises do not establish a performance improvement. Nsight Systems: Capture the actual vendor executable inside each allocated worker; preserve raw numerical output separately.",
  "templating": {
    "list": [
      {
        "name": "workspace",
        "type": "textbox",
        "label": "Fixed learner workspace",
        "current": {
          "text": "learner-01",
          "value": "learner-01"
        }
      },
      {
        "name": "profile",
        "type": "custom",
        "query": "small,large",
        "current": {
          "text": "small",
          "value": "small"
        }
      },
      {
        "name": "node",
        "type": "query",
        "label": "Node exporter instance",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(node_memory_MemAvailable_bytes, instance)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "name": "gpu_node",
        "type": "query",
        "label": "GPU worker",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL, Hostname)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "gpu",
        "type": "query",
        "label": "GPU index on selected workers",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL{Hostname=~\"${gpu_node:regex}\"}, gpu)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
