{
  "uid": "course-ceada2e3e92441a16092f07b",
  "title": "Lab 16: Observe FSDP2 sharded training state",
  "tags": [
    "gpu-course",
    "advanced-gpu-communication",
    "16_fsdp2_train"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "description": "Draw persistent shards separately from temporarily gathered parameters. Which memory survives between steps? Which communication is needed before forward and during backward? Explain why small models can become slower when communication overhead dominates. Use measured summaries for short runs. Job-window telemetry is correlation unless GPU exclusivity is established. A faster result must retain correctness and the same useful work. Nsight Systems: Capture inside each participating GPU rank, retaining separate reports for cross-rank correlation.",
  "templating": {
    "list": [
      {
        "name": "workspace",
        "type": "textbox",
        "label": "Fixed learner workspace",
        "current": {
          "text": "learner-01",
          "value": "learner-01"
        }
      },
      {
        "name": "profile",
        "type": "custom",
        "query": "small,large",
        "current": {
          "text": "small",
          "value": "small"
        }
      },
      {
        "name": "node",
        "type": "query",
        "label": "Node exporter instance",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(node_memory_MemAvailable_bytes, instance)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "name": "gpu_node",
        "type": "query",
        "label": "GPU worker",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL, Hostname)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "gpu",
        "type": "query",
        "label": "GPU index on selected workers",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL{Hostname=~\"${gpu_node:regex}\"}, gpu)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Selected comparison generation",
      "type": "table",
      "description": "These are explicitly selected completed runs. Submission of another job does not replace them. Summary panels always show the current selected pair, even with a historical time range. Check generation and experiment timestamps.",
      "datasource": {
        "type": "prometheus",
        "uid": "course-soperator-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(course_lab_publication_generation{course=\"advanced-gpu-communication\",lab=\"16_fsdp2_train\",workspace=\"$workspace\",profile=\"$profile\"} @ now())",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{Hostname}} GPU {{gpu}}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No measured data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Value(?: #A)?$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
