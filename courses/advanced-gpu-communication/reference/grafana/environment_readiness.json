    {
      "id": 12,
      "title": "Node CPU busy",
      "type": "timeseries",
      "description": "Node context; correlate the instance and experiment interval. Other jobs can contribute. Missing series means unavailable telemetry.",
      "datasource": {
        "type": "prometheus",
        "uid": "course-soperator-metrics"
