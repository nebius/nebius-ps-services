{
  "uid": "course-53ab863aa03dcb22961bbd34",
  "title": "Environment readiness",
  "tags": [
    "gpu-course",
    "advanced-gpu-communication",
    "environment_readiness"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "description": "Can both workers execute the canary and produce readable reports? Baseline and candidate slots contain the two worker readiness results. They are readiness records, not optimization candidates. Inspect GPU telemetry and require fresh publication confirmation.",
  "templating": {
    "list": [
      {
        "name": "workspace",
        "type": "textbox",
        "label": "Fixed learner workspace",
        "current": {
          "text": "learner-01",
          "value": "learner-01"
        }
      },
      {
        "name": "profile",
        "type": "custom",
        "query": "small,large",
        "current": {
          "text": "small",
          "value": "small"
        }
      },
      {
        "name": "node",
        "type": "query",
        "label": "Node exporter instance",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(node_memory_MemAvailable_bytes, instance)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "name": "gpu_node",
        "type": "query",
        "label": "GPU worker",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL, Hostname)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "gpu",
        "type": "query",
        "label": "GPU index on selected workers",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL{Hostname=~\"${gpu_node:regex}\"}, gpu)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Selected comparison generation",
      "type": "table",
      "description": "These are explicitly selected completed runs. Submission of another job does not replace them. Summary panels always show the current selected pair, even with a historical time range. Check generation and experiment timestamps.",
      "datasource": {
        "type": "prometheus",
        "uid": "course-soperator-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(course_lab_publication_generation{course=\"advanced-gpu-communication\",lab=\"environment_readiness\",workspace=\"$workspace\",profile=\"$profile\"} @ now())",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{Hostname}} GPU {{gpu}}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No measured data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Value(?: #A)?$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "slot",
                "case",
                "Value",
                "Value #A"
              ]
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Systems report exists",
      "type": "barchart",
      "description": "A readable local report from the readiness canary; report size does not measure GPU performance.",
      "datasource": {
        "type": "prometheus",
        "uid": "course-soperator-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(course_lab_systems_report_bytes{course=\"advanced-gpu-communication\",lab=\"environment_readiness\",workspace=\"$workspace\",profile=\"$profile\",slot=\"baseline\"} @ now())",
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "(course_lab_systems_report_bytes{course=\"advanced-gpu-communication\",lab=\"environment_readiness\",workspace=\"$workspace\",profile=\"$profile\",slot=\"candidate\"} @ now())",
          "instant": true,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No measured data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Baseline"
              },
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Candidate"
              },
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "case"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "case",
        "orientation": "vertical",
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "case",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "case",
                "Value #A",
                "Value #B"
              ]
            }
          }
        }
      ]
    },
