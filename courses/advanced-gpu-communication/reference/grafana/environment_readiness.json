      "gridPos": {
        "x": 0,
        "y": 77,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(instance)(rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"${node:regex}\"}[5m])))",
