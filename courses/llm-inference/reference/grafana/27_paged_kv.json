{
  "uid": "course-00de048d808eabd28450d8ba",
  "title": "Lab 27: Follow paged-cache allocation, growth, and recycling",
  "tags": [
    "gpu-course",
    "llm-inference",
    "27_paged_kv"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "description": "Why can a request's logical pages map to nonadjacent physical IDs? Calculate unused slots in the final page. Explain why growth must reserve capacity before updating the request length. This CPU page-allocation simulation measures model state, not GPU memory traffic. Missing metrics remain unknown; sampled telemetry is context, not a timing measurement. Nsight Systems: This CPU page-allocation simulation measures model state, not GPU memory traffic.",
  "templating": {
    "list": [
      {
        "name": "workspace",
        "type": "textbox",
        "label": "Fixed learner workspace",
        "current": {
          "text": "learner-01",
          "value": "learner-01"
        }
      },
      {
        "name": "profile",
        "type": "custom",
        "query": "small,large",
        "current": {
          "text": "small",
          "value": "small"
        }
      },
      {
        "name": "node",
        "type": "query",
        "label": "Node exporter instance",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(node_memory_MemAvailable_bytes, instance)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Selected comparison generation",
      "type": "table",
      "description": "These are explicitly selected completed runs. Submission of another job does not replace them. Summary panels always show the current selected pair, even with a historical time range. Check generation and experiment timestamps.",
      "datasource": {
        "type": "prometheus",
        "uid": "course-soperator-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(course_lab_publication_generation{course=\"llm-inference\",lab=\"27_paged_kv\",workspace=\"$workspace\",profile=\"$profile\"} @ now())",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{Hostname}} GPU {{gpu}}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No measured data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Value(?: #A)?$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "slot",
                "case",
                "Value",
                "Value #A"
              ]
            }
          }
        }
      ]
