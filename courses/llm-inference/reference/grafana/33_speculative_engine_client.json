    {
      "id": 7,
      "title": "GPU activity during the selected window",
      "type": "timeseries",
      "description": "Sampled device context, not per-kernel timing or proof of exclusive job attribution. Empty data is unknown, never zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "course-soperator-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_UTIL{Hostname=~\"${gpu_node:regex}\",gpu=~\"${gpu:regex}\"}",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{Hostname}} GPU {{gpu}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "No measured data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "title": "Framebuffer memory used",
