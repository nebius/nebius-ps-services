{
  "uid": "course-906b9c8d3ff8d0ecc97af68c",
  "title": "Lab 33: Check greedy equivalence in a speculative engine campaign",
  "tags": [
    "gpu-course",
    "llm-inference",
    "33_speculative_engine_client"
  ],
  "schemaVersion": 39,
  "version": 3,
  "editable": false,
  "timezone": "utc",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "description": "Does acceptance reduce target work enough to offset draft execution and verification? Compare actual output lengths, latency, and throughput under the same load. Keep startup memory and initialization separate from steady serving. This helper records response equivalence. Performance evidence belongs to the separately collected campaign results; no latency or throughput is inferred from response digests. Nsight Systems: Capture the owned GPU server and its worker descendants while the client supplies requests.",
  "templating": {
    "list": [
      {
        "name": "workspace",
        "type": "textbox",
        "label": "Fixed learner workspace",
        "current": {
          "text": "learner-01",
          "value": "learner-01"
        }
      },
      {
        "name": "profile",
        "type": "custom",
        "query": "small,large",
        "current": {
          "text": "small",
          "value": "small"
        }
      },
      {
        "name": "node",
        "type": "query",
        "label": "Node exporter instance",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(node_memory_MemAvailable_bytes, instance)",
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1
      },
      {
        "name": "gpu_node",
        "type": "query",
        "label": "GPU worker",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL, Hostname)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      },
      {
        "name": "gpu",
        "type": "query",
        "label": "GPU index on selected workers",
        "datasource": {
          "type": "prometheus",
          "uid": "course-soperator-metrics"
        },
        "query": "label_values(DCGM_FI_DEV_GPU_UTIL{Hostname=~\"${gpu_node:regex}\"}, gpu)",
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Selected comparison generation",
      "type": "table",
      "description": "These are explicitly selected completed runs. Submission of another job does not replace them. Summary panels always show the current selected pair, even with a historical time range. Check generation and experiment timestamps.",
      "datasource": {
        "type": "prometheus",
        "uid": "course-soperator-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(course_lab_publication_generation{course=\"llm-inference\",lab=\"33_speculative_engine_client\",workspace=\"$workspace\",profile=\"$profile\"} @ now())",
          "instant": true,
          "range": false,
          "format": "table",
          "legendFormat": "{{Hostname}} GPU {{gpu}}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No measured data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^Value(?: #A)?$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "slot",
                "case",
                "Value",
                "Value #A"
              ]
            }
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Requests",
      "type": "barchart",
      "description": "Measured artifact field measurements.requests. Compare identical case and workload in both selected slots; keep the original JSON for full configuration and distributions.",
      "datasource": {
        "type": "prometheus",
        "uid": "course-soperator-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(course_lab_requests{course=\"llm-inference\",lab=\"33_speculative_engine_client\",workspace=\"$workspace\",profile=\"$profile\",slot=\"baseline\"} @ now())",
          "instant": true,
          "format": "table",
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "(course_lab_requests{course=\"llm-inference\",lab=\"33_speculative_engine_client\",workspace=\"$workspace\",profile=\"$profile\",slot=\"candidate\"} @ now())",
          "instant": true,
          "format": "table",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "No measured data"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Baseline"
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Candidate"
              },
              {
                "id": "unit",
                "value": "none"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "case"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "xField": "case",
        "orientation": "vertical",
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "case",
            "mode": "outerTabular"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "case",
                "Value #A",
                "Value #B"
              ]
            }
          }
        }
      ]
    },
