name: GitHub AI continuation
on:
  workflow_dispatch:
    inputs:
      completion:
        description: Exact retained completion record
        required: true
        type: string
  workflow_run:
    workflows: ["GitHub AI automation", "Merge automation CI", "vpngw-ci", "nebius-cxcli-ci", "nebius-cxcli-nsight", "Skills project specs CI", "courses-ci"]
    types: [completed]
permissions:
  contents: write
  pull-requests: write
  issues: write
  actions: write
  statuses: write
jobs:
  reconcile:
    if: >-
      (github.event_name == 'workflow_dispatch' && github.ref == format('refs/heads/{0}', github.event.repository.default_branch)) ||
      (github.event.workflow_run.event == 'workflow_dispatch' &&
      github.event.workflow_run.head_branch == github.event.repository.default_branch)
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    environment: github-ai-automation
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          version: '0.13.7'
          enable-cache: false
      - name: Reconcile immutable producer evidence
        env:
          GH_TOKEN: ${{ github.token }}
          COMPLETION_KEY: ${{ inputs.completion }}
          AI_AUTOMATION_REPOSITORY_ID: ${{ github.repository_id }}
          PRODUCER_RUN_ID: ${{ github.event.workflow_run.id }}
          AI_AUTOMATION_PR_REVIEW: ${{ vars.AI_AUTOMATION_PR_REVIEW || 'disabled' }}
          AI_AUTOMATION_MERGE_FORK_CONTRIBUTION: ${{ vars.AI_AUTOMATION_MERGE_FORK_CONTRIBUTION || 'false' }}
          AI_AUTOMATION_STATE_BUCKET: ${{ secrets.AI_AUTOMATION_STATE_BUCKET }}
          AI_AUTOMATION_STATE_ENDPOINT: ${{ secrets.AI_AUTOMATION_STATE_ENDPOINT }}
          AI_AUTOMATION_STATE_ACCESS_KEY_ID: ${{ secrets.AI_AUTOMATION_STATE_ACCESS_KEY_ID }}
          AI_AUTOMATION_STATE_SECRET_ACCESS_KEY: ${{ secrets.AI_AUTOMATION_STATE_SECRET_ACCESS_KEY }}
        run: |
          if [ "$GITHUB_EVENT_NAME" = workflow_dispatch ]; then
            uv run --locked --project github-ai-automation github-ai-automation reconcile-completion "$COMPLETION_KEY"
          else
            uv run --locked --project github-ai-automation github-ai-automation continue-run "$PRODUCER_RUN_ID"
          fi
