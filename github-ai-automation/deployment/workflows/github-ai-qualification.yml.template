name: GitHub AI qualification
run-name: ai-shadow-pr-${{ inputs.pr_number }}
'on':
  workflow_dispatch:
    inputs:
      pr_number:
        description: Existing PR to assess without GitHub writes
        required: true
        type: string
permissions:
  contents: read
  pull-requests: read
  actions: read
jobs:
  image:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    environment: github-ai-automation
    outputs:
      image_ref: ${{ steps.guard.outputs.image_ref }}
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        ref: ${{ github.sha }}
        persist-credentials: false
    - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2
      with:
        version: 0.13.7
        enable-cache: false
    - name: Pull the selected runtime
      id: pull
      env:
        IMAGE_REF: ${{ vars.AI_AUTOMATION_AGENT_IMAGE_REF }}
      run: 'set -euo pipefail

        [[ "$IMAGE_REF" =~ ^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$ ]]

        docker pull "$IMAGE_REF"

        printf ''id=%s\n'' "${IMAGE_REF##*@}" >> "$GITHUB_OUTPUT"

        '
    - id: guard
      env:
        GH_TOKEN: ${{ github.token }}
        AI_AUTOMATION_REPOSITORY_ID: ${{ vars.AI_AUTOMATION_REPOSITORY_ID }}
        AI_AUTOMATION_STATE_BUCKET: ${{ secrets.AI_AUTOMATION_STATE_BUCKET }}
        AI_AUTOMATION_STATE_ENDPOINT: ${{ secrets.AI_AUTOMATION_STATE_ENDPOINT }}
        AI_AUTOMATION_STATE_ACCESS_KEY_ID: ${{ secrets.AI_AUTOMATION_STATE_ACCESS_KEY_ID }}
        AI_AUTOMATION_STATE_SECRET_ACCESS_KEY: ${{ secrets.AI_AUTOMATION_STATE_SECRET_ACCESS_KEY }}
        AI_AUTOMATION_IMAGE_QUALIFICATION_RUN_ID: ${{ vars.AI_AUTOMATION_IMAGE_QUALIFICATION_RUN_ID }}
        AI_AUTOMATION_AGENT_IMAGE_REF: ${{ vars.AI_AUTOMATION_AGENT_IMAGE_REF }}
        AI_AUTOMATION_AGENT_IMAGE: ${{ steps.pull.outputs.id }}
        TF_MODEL_REVIEW: ${{ vars.TF_MODEL_REVIEW }}
        TF_MODEL_FIX: ${{ vars.TF_MODEL_FIX }}
      run: uv run --locked --project github-ai-automation github-ai-automation image selected "$RUNNER_TEMP/image.json"
    - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
      with:
        name: shadow-image-${{ github.run_id }}-${{ github.run_attempt }}
        path: ${{ runner.temp }}/image.json
        if-no-files-found: error
        retention-days: 30
  shadow:
    runs-on: ubuntu-24.04
    timeout-minutes: 60
    environment: github-ai-evaluation
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        ref: ${{ github.sha }}
        persist-credentials: false
    - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2
      with:
        version: 0.13.7
        enable-cache: false
    - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333
      with:
        name: shadow-image-${{ github.run_id }}-${{ github.run_attempt }}
        path: ${{ runner.temp }}/image
    - name: Pull the selected runtime
      id: image
      env:
        IMAGE_REF: ${{ needs.image.outputs.image_ref }}
      run: 'set -euo pipefail

        [[ "$IMAGE_REF" =~ ^[a-zA-Z0-9./:_-]+@sha256:[a-f0-9]{64}$ ]]

        docker pull "$IMAGE_REF"

        printf ''id=%s\n'' "${IMAGE_REF##*@}" >> "$GITHUB_OUTPUT"

        '
    - name: Rehearse shared assessment
      env:
        GH_TOKEN: ${{ github.token }}
        PR_NUMBER: ${{ inputs.pr_number }}
        AI_AUTOMATION_REPOSITORY_ID: ${{ vars.AI_AUTOMATION_REPOSITORY_ID }}
        AI_AUTOMATION_AGENT_IMAGE: ${{ steps.image.outputs.id }}
        TF_MODEL_REVIEW: ${{ vars.TF_MODEL_REVIEW }}
        AI_AUTOMATION_TF_API_KEY: ${{ secrets.AI_AUTOMATION_TF_API_KEY }}
        AI_AUTOMATION_IMAGE_QUALIFICATION_RUN_ID: ${{ vars.AI_AUTOMATION_IMAGE_QUALIFICATION_RUN_ID }}
        AI_AUTOMATION_AGENT_IMAGE_REF: ${{ needs.image.outputs.image_ref }}
      run: uv run --locked --project github-ai-automation github-ai-automation qualify-pr "$PR_NUMBER" "$RUNNER_TEMP/shadow.json"
        "$RUNNER_TEMP/image/image.json"
    - name: Retain qualification report
      if: always()
      uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
      with:
        name: qualification-shadow-${{ github.run_id }}-${{ github.run_attempt }}
        path: ${{ runner.temp }}/shadow.json
        if-no-files-found: error
        retention-days: 30
    needs: image
