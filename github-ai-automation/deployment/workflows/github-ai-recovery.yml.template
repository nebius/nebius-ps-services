name: GitHub AI recovery
permissions:
  contents: read
  actions: write
  pull-requests: read
jobs:
  recover:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-24.04
    timeout-minutes: 40
    environment: github-ai-automation
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        ref: ${{ github.sha }}
        persist-credentials: false
    - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2
      with:
        version: 0.13.7
        enable-cache: false
    - name: Recover interrupted operations
      env:
        GH_TOKEN: ${{ github.token }}
        AI_AUTOMATION_PR_REVIEW: ${{ vars.AI_AUTOMATION_PR_REVIEW || 'disabled' }}
        AI_AUTOMATION_MERGE_FORK_CONTRIBUTION: ${{ vars.AI_AUTOMATION_MERGE_FORK_CONTRIBUTION || 'false' }}
        AI_AUTOMATION_STATE_BUCKET: ${{ secrets.AI_AUTOMATION_STATE_BUCKET }}
        AI_AUTOMATION_STATE_ENDPOINT: ${{ secrets.AI_AUTOMATION_STATE_ENDPOINT }}
        AI_AUTOMATION_STATE_ACCESS_KEY_ID: ${{ secrets.AI_AUTOMATION_STATE_ACCESS_KEY_ID }}
        AI_AUTOMATION_STATE_SECRET_ACCESS_KEY: ${{ secrets.AI_AUTOMATION_STATE_SECRET_ACCESS_KEY }}
        AI_AUTOMATION_REPOSITORY_ID: ${{ vars.AI_AUTOMATION_REPOSITORY_ID }}
        AI_AUTOMATION_RELEASE_PUBLISH: ${{ vars.AI_AUTOMATION_RELEASE_PUBLISH || 'false' }}
        AI_AUTOMATION_NEBIUS_CREDENTIALS: ${{ secrets.AI_AUTOMATION_NEBIUS_CREDENTIALS }}
        AI_AUTOMATION_TEST_TENANT_ID: ${{ secrets.AI_AUTOMATION_TEST_TENANT_ID }}
        AI_AUTOMATION_TEST_PROJECT_ID: ${{ secrets.AI_AUTOMATION_TEST_PROJECT_ID }}
        AI_AUTOMATION_TEST_REGION: ${{ secrets.AI_AUTOMATION_TEST_REGION }}
      run: uv run --locked --project github-ai-automation github-ai-automation recover
'on':
  schedule:
  - cron: 3-58/5 * * * *
  workflow_dispatch: {}
