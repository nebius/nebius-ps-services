name: GitHub AI state qualification
'on':
  workflow_dispatch: {}
permissions:
  contents: read
  actions: read
concurrency:
  group: github-ai-state-qualification-${{ github.repository }}
  cancel-in-progress: false
jobs:
  sentinel:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    environment: github-ai-automation
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2
        with:
          version: '0.13.7'
          enable-cache: false
      - name: Observe the pre-established harmless sentinel
        env:
          GH_TOKEN: ${{ github.token }}
          AI_AUTOMATION_REPOSITORY_ID: ${{ vars.AI_AUTOMATION_REPOSITORY_ID }}
          AI_AUTOMATION_STATE_BUCKET: ${{ secrets.AI_AUTOMATION_STATE_BUCKET }}
          AI_AUTOMATION_STATE_ENDPOINT: ${{ secrets.AI_AUTOMATION_STATE_ENDPOINT }}
          AI_AUTOMATION_STATE_ACCESS_KEY_ID: ${{ secrets.AI_AUTOMATION_STATE_ACCESS_KEY_ID }}
          AI_AUTOMATION_STATE_SECRET_ACCESS_KEY: ${{ secrets.AI_AUTOMATION_STATE_SECRET_ACCESS_KEY }}
        run: uv run --locked --project github-ai-automation github-ai-automation state-sentinel "$RUNNER_TEMP/sentinel.json"
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        with:
          name: state-sentinel-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/sentinel.json
          if-no-files-found: error
          retention-days: 90
  qualify:
    needs: sentinel
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    environment: github-ai-state-qualification
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2
        with:
          version: '0.13.7'
          enable-cache: false
      - uses: actions/download-artifact@9000827ccba6bdab643e8b6fd33ac0654aef8333
        with:
          name: state-sentinel-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/sentinel
      - name: Check real conditional state operations
        env:
          GH_TOKEN: ${{ github.token }}
          AI_AUTOMATION_REPOSITORY_ID: ${{ vars.AI_AUTOMATION_REPOSITORY_ID }}
          AI_AUTOMATION_STATE_BUCKET: ${{ secrets.AI_AUTOMATION_STATE_BUCKET }}
          AI_AUTOMATION_STATE_ENDPOINT: ${{ secrets.AI_AUTOMATION_STATE_ENDPOINT }}
          AI_AUTOMATION_STATE_ACCESS_KEY_ID: ${{ secrets.AI_AUTOMATION_STATE_ACCESS_KEY_ID }}
          AI_AUTOMATION_STATE_SECRET_ACCESS_KEY: ${{ secrets.AI_AUTOMATION_STATE_SECRET_ACCESS_KEY }}
          AI_AUTOMATION_PRODUCTION_STATE_BUCKET: ${{ secrets.AI_AUTOMATION_PRODUCTION_STATE_BUCKET }}
        run: uv run --locked --project github-ai-automation github-ai-automation qualify-state "$RUNNER_TEMP/state-qualification.json" "$RUNNER_TEMP/sentinel/sentinel.json"
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
        if: always()
        with:
          name: state-qualification-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/state-qualification.json
          if-no-files-found: error
          retention-days: 90
