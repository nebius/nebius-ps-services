name: GitHub AI live-test waiver
run-name: ai-waiver-${{ inputs.pr_number }}-${{ inputs.request_id }}
on:
  workflow_dispatch:
    inputs:
      request_id:
        description: Client correlation identifier
        required: false
        type: string
      pr_number:
        description: PR number; waiver persists across commits and reopenings
        required: true
        type: string
      reason:
        description: Public-safe reason; never include secrets or target IDs
        required: true
        type: string
      revoke:
        description: Restore required live testing
        type: boolean
        default: false
permissions:
  contents: read
  pull-requests: write
  actions: read
jobs:
  record:
    if: github.ref == format('refs/heads/{0}', github.event.repository.default_branch)
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    environment: github-ai-automation
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          version: '0.13.7'
          enable-cache: false
      - name: Verify human authority and persist PR policy
        env:
          GH_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ inputs.pr_number }}
          REASON: ${{ inputs.reason }}
          REVOKE: ${{ inputs.revoke }}
          AI_AUTOMATION_REPOSITORY_ID: ${{ vars.AI_AUTOMATION_REPOSITORY_ID }}
          AI_AUTOMATION_STATE_BUCKET: ${{ secrets.AI_AUTOMATION_STATE_BUCKET }}
          AI_AUTOMATION_STATE_ENDPOINT: ${{ secrets.AI_AUTOMATION_STATE_ENDPOINT }}
          AI_AUTOMATION_STATE_ACCESS_KEY_ID: ${{ secrets.AI_AUTOMATION_STATE_ACCESS_KEY_ID }}
          AI_AUTOMATION_STATE_SECRET_ACCESS_KEY: ${{ secrets.AI_AUTOMATION_STATE_SECRET_ACCESS_KEY }}
        run: |
          set -euo pipefail
          args=()
          if [ "$REVOKE" = true ]; then args+=(--revoke); fi
          uv run --locked --project github-ai-automation github-ai-automation waiver "$PR_NUMBER" "$REASON" "${args[@]}"
