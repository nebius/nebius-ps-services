name: Protected merge
run-name: "Merge PR ${{ inputs.pr }} at ${{ inputs.head }} (${{ inputs.method }})"

on:
  workflow_dispatch:
    inputs:
      pr:
        description: Pull request number
        required: true
        type: string
      head:
        description: Exact locally reviewed head SHA
        required: true
        type: string
      review_id:
        description: Trusted operator COMMENT review ID
        required: true
        type: string
      method:
        description: Merge method (merge queues require a maintainer)
        default: squash
        type: choice
        options: [squash, merge, rebase]

permissions:
  contents: read
  pull-requests: read
  issues: read
  actions: read
  checks: read
  statuses: read

jobs:
  candidates:
    name: merge-candidates
    if: >-
      github.ref == format('refs/heads/{0}', github.event.repository.default_branch) &&
      (github.event_name != 'workflow_run' || github.event.workflow_run.event == 'pull_request')
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      targets: ${{ steps.plan.outputs.targets }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - id: plan
        env:
          GH_TOKEN: ${{ github.token }}
          MERGE_OPERATOR_IDS: ${{ vars.MERGE_OPERATOR_IDS }}
        run: |
          set -euo pipefail
          targets=$(python3 skills/merge-pr/scripts/merge_gate.py candidates)
          printf 'targets=%s\n' "$targets" >> "$GITHUB_OUTPUT"


  admission:
    name: merge-admission
    needs: candidates
    if: needs.candidates.outputs.targets != '[]'
    strategy:
      fail-fast: false
      matrix:
        target: ${{ fromJSON(needs.candidates.outputs.targets) }}
    concurrency:
      group: merge-admission-${{ github.repository }}-${{ matrix.target.pr }}
      cancel-in-progress: false
    environment: github-ai-automation
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      pull-requests: read
      issues: read
      actions: read
      checks: read
      statuses: read
    env:
      AI_AUTOMATION_PR_REVIEW: ${{ vars.AI_AUTOMATION_PR_REVIEW || 'disabled' }}
      AI_AUTOMATION_MERGE_FORK_CONTRIBUTION: ${{ vars.AI_AUTOMATION_MERGE_FORK_CONTRIBUTION || 'false' }}
      AI_AUTOMATION_STATE_BUCKET: ${{ secrets.AI_AUTOMATION_STATE_BUCKET }}
      AI_AUTOMATION_STATE_ENDPOINT: ${{ secrets.AI_AUTOMATION_STATE_ENDPOINT }}
      AI_AUTOMATION_STATE_ACCESS_KEY_ID: ${{ secrets.AI_AUTOMATION_STATE_ACCESS_KEY_ID }}
      AI_AUTOMATION_STATE_SECRET_ACCESS_KEY: ${{ secrets.AI_AUTOMATION_STATE_SECRET_ACCESS_KEY }}
      MERGE_OPERATOR_IDS: ${{ vars.MERGE_OPERATOR_IDS }}
      PR_NUMBER: ${{ matrix.target.pr }}
      PR_HEAD: ${{ matrix.target.head }}
      REVIEW_ID: ${{ matrix.target.review_id }}
      MERGE_METHOD: ${{ matrix.target.method }}
    steps:
      # Only trusted default-branch code and its locked dependencies run here.
      # Never check out PR code, restore candidate caches, or run an AI agent.
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          version: '0.13.7'
          enable-cache: false
      - name: Verify admission before effects
        id: gate
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          status=0
          uv run --locked --project github-ai-automation python skills/merge-pr/scripts/merge_gate.py check --pr "$PR_NUMBER" \
            --head "$PR_HEAD" --review-id "$REVIEW_ID" > "$RUNNER_TEMP/gate.json" || status=$?
          cat "$RUNNER_TEMP/gate.json"
          if [ "$status" = 2 ]; then
            echo 'ready=false' >> "$GITHUB_OUTPUT"
            exit 0
          fi
          if [ "$status" != 0 ]; then exit "$status"; fi
          python3 - <<'PYTHON'
          import json, os
          from pathlib import Path
          result = json.loads((Path(os.environ['RUNNER_TEMP']) / 'gate.json').read_text())
          with open(os.environ['GITHUB_OUTPUT'], 'a') as out:
              out.write('ready=true\nworkflows=' + str(result['workflows']).lower() + '\n')
          PYTHON
      - name: Freeze admission receipt before effects
        if: steps.gate.outputs.ready == 'true'
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          uv run --locked --project github-ai-automation python skills/merge-pr/scripts/merge_gate.py intent --pr "$PR_NUMBER" \
            --head "$PR_HEAD" --review-id "$REVIEW_ID" --method "$MERGE_METHOD" > "$RUNNER_TEMP/intent.json"
      - name: Preserve admission for interrupted-run recovery
        id: intent
        if: steps.gate.outputs.ready == 'true'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        with:
          name: merge-intent-${{ matrix.target.pr }}-${{ matrix.target.head }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/intent.json
          retention-days: 30
          if-no-files-found: error
  merge:
    name: protected-merge
    needs: [candidates, admission]
    if: always() && needs.candidates.result == 'success' && needs.candidates.outputs.targets != '[]'
    strategy:
      fail-fast: false
      matrix:
        target: ${{ fromJSON(needs.candidates.outputs.targets) }}
    concurrency:
      group: protected-merge-${{ github.repository }}-${{ matrix.target.pr }}
      cancel-in-progress: false
    environment: github-ai-automation
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: write
      pull-requests: write
      issues: read
      actions: read
      checks: read
      statuses: read
    env:
      AI_AUTOMATION_PR_REVIEW: ${{ vars.AI_AUTOMATION_PR_REVIEW || 'disabled' }}
      AI_AUTOMATION_MERGE_FORK_CONTRIBUTION: ${{ vars.AI_AUTOMATION_MERGE_FORK_CONTRIBUTION || 'false' }}
      AI_AUTOMATION_STATE_BUCKET: ${{ secrets.AI_AUTOMATION_STATE_BUCKET }}
      AI_AUTOMATION_STATE_ENDPOINT: ${{ secrets.AI_AUTOMATION_STATE_ENDPOINT }}
      AI_AUTOMATION_STATE_ACCESS_KEY_ID: ${{ secrets.AI_AUTOMATION_STATE_ACCESS_KEY_ID }}
      AI_AUTOMATION_STATE_SECRET_ACCESS_KEY: ${{ secrets.AI_AUTOMATION_STATE_SECRET_ACCESS_KEY }}
      GH_TOKEN: ${{ github.token }}
      MERGE_OPERATOR_IDS: ${{ vars.MERGE_OPERATOR_IDS }}
      PR_NUMBER: ${{ matrix.target.pr }}
      PR_HEAD: ${{ matrix.target.head }}
      REVIEW_ID: ${{ matrix.target.review_id }}
      MERGE_METHOD: ${{ matrix.target.method }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          version: '0.13.7'
          enable-cache: false
      - name: Revalidate uploaded admission and request protected merge
        run: |
          status=0
          uv run --locked --project github-ai-automation github-ai-automation merge "$PR_NUMBER" "$PR_HEAD" "$REVIEW_ID" --method "$MERGE_METHOD" || status=$?
          if [ "$status" != 0 ] && [ "$status" != 2 ]; then exit "$status"; fi
