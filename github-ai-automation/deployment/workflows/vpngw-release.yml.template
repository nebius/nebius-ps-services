# Trusted reusable build profile. Remote tags and publication belong to github-ai-release.yml.
name: nebius-vpngw-release-publish
'on':
  workflow_call:
    inputs:
      source_sha:
        required: true
        type: string
      tag:
        required: true
        type: string
permissions:
  contents: read
env:
  APP_DIR: services/vpngw
  TAG_PREFIX: nebius-vpngw
  PACKAGE_IMPORT_NAME: nebius_vpngw
  MAIN_BRANCH: main
  ASSET_GLOB: dist/*.whl
jobs:
  ordinary-job-settlement:
    name: Ordinary systemd and networkd settlement
    runs-on: ubuntu-24.04
    timeout-minutes: 35
    permissions:
      contents: read
    steps:
    - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        ref: ${{ inputs.tag }}
        fetch-depth: 0
        persist-credentials: false
    - name: Verify admitted source identity
      env:
        EXPECTED_SOURCE: ${{ inputs.source_sha }}
      run: test "$(git rev-parse HEAD)" = "$EXPECTED_SOURCE"
    - name: Verify delegated work in isolated systemd
      working-directory: services/vpngw
      run: python3 tests/systemd/run.py
  release:
    needs: ordinary-job-settlement
    name: nebius-vpngw-release
    runs-on: ubuntu-latest
    defaults:
      run:
        shell: bash
        working-directory: ${{ env.APP_DIR }}
    steps:
    - name: Checkout
      uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1
      with:
        fetch-depth: 0
        ref: ${{ inputs.tag }}
        persist-credentials: false
    - name: Verify admitted source identity
      env:
        EXPECTED_SOURCE: ${{ inputs.source_sha }}
      run: test "$(git rev-parse HEAD)" = "$EXPECTED_SOURCE"
    - name: Resolve release version from tag
      id: version
      env:
        REF_NAME: ${{ inputs.tag }}
      run: python3 "${GITHUB_WORKSPACE}/skills/github-workflows/scripts/publication.py" version --tag "$REF_NAME" --prefix
        "$TAG_PREFIX"
    - name: Resolve tagged commit
      id: revision
      run: 'set -euo pipefail

        echo "commit=$(git rev-list -n 1 "${{ steps.version.outputs.tag }}")" >> "$GITHUB_OUTPUT"

        '
    - name: Ensure tag commit belongs to main history
      env:
        RELEASE_COMMIT: ${{ steps.revision.outputs.commit }}
      run: python3 "${GITHUB_WORKSPACE}/skills/github-workflows/scripts/publication.py" ancestry --commit "$RELEASE_COMMIT"
        --branch "$MAIN_BRANCH"
    - name: Set up Python
      uses: actions/setup-python@6d4fd22b20465ccc0f7354476588e8df7c9ca0e0
      with:
        python-version: '3.12'
    - name: Verify source-checkout runtime version
      env:
        EXPECTED_VERSION: ${{ steps.version.outputs.version }}
      run: "set -euo pipefail\nif ! resolved_version=\"$(\n  PYTHONPATH=src python - \"${EXPECTED_VERSION}\" \"${PACKAGE_IMPORT_NAME}\"\
        \ <<'PY'\nimport importlib\nimport sys\n\nexpected = sys.argv[1]\nmodule_name = sys.argv[2]\npackage = importlib.import_module(module_name)\n\
        resolved = getattr(package, \"__version__\", \"\")\n\nif resolved != expected:\n    print(resolved, end=\"\")\n  \
        \  raise SystemExit(1)\n\nprint(resolved, end=\"\")\nPY\n)\"; then\n  echo \"::error::Source checkout resolved runtime\
        \ version '${resolved_version:-unknown}' instead of '${EXPECTED_VERSION}'\"\n  exit 1\nfi\necho \"Verified source-checkout\
        \ runtime version ${resolved_version}.\"\n"
    - name: Install dependencies
      run: 'set -euo pipefail

        python -m pip install --upgrade pip

        pip install -e ".[dev]"

        '
    - name: Helper shell checks
      run: 'set -euo pipefail

        bash -n misc/gcp-vpngw.sh

        bash -n misc/gcp-vpngw-vm-ha.sh

        bash -n misc/gcp-vpngw-classic-vm-ha.sh

        bash -n misc/fix-vpngw-esp4.sh

        ./misc/gcp-vpngw.sh --help >/dev/null

        ./misc/gcp-vpngw.sh --vm-ha-peer --help >/dev/null

        ./misc/gcp-vpngw.sh --classic-vm-ha-peer --help >/dev/null

        ./misc/fix-vpngw-esp4.sh --help >/dev/null

        '
    - name: Lint
      run: python -m ruff check src tests misc
    - name: Test
      run: python -m pytest -q
    - name: Build artifact
      run: "set -euo pipefail\nrm -rf build dist\nPYTHONWARNINGS=\"ignore:No GlobalOverrides context is active:UserWarning\"\
        \ \\\n  python -m build --wheel --no-isolation\n"
    - name: Resolve and verify artifact
      id: asset
      run: "set -euo pipefail\nassets=()\nmapfile -t assets < <(compgen -G \"${ASSET_GLOB}\" | sort)\nif [[ \"${#assets[@]}\"\
        \ -eq 0 ]]; then\n  echo \"::error::No release asset found with glob ${ASSET_GLOB}\"\n  exit 1\nfi\nasset=\"${assets[0]}\"\
        \n\nwheel_version=\"$(python - \"${asset}\" <<'PY'\nimport sys\nimport zipfile\nfrom email import message_from_bytes\n\
        \nwheel = sys.argv[1]\nwith zipfile.ZipFile(wheel) as zf:\n    metadata_names = [n for n in zf.namelist() if n.endswith(\"\
        METADATA\")]\n    if not metadata_names:\n        raise SystemExit(\"No METADATA found in wheel\")\n    metadata =\
        \ message_from_bytes(zf.read(metadata_names[0]))\n    print(metadata.get(\"Version\", \"\"))\nPY\n)\"\n\nif [[ \"\
        ${wheel_version}\" != \"${{ steps.version.outputs.version }}\" ]]; then\n  echo \"::error::Wheel version (${wheel_version})\
        \ does not match tag version (${{ steps.version.outputs.version }})\"\n  exit 1\nfi\n\necho \"path=${asset}\" >> \"\
        $GITHUB_OUTPUT\"\n"
    - name: Stage build outputs without publication credentials
      env:
        WHEEL: ${{ steps.asset.outputs.path }}
      run: "python3 - <<'PYTHON'\nfrom pathlib import Path\nimport os, shutil\nroot = Path.cwd().resolve()\nout = Path(os.environ[\"\
        RUNNER_TEMP\"]) / \"ai-release-assets\"\nout.mkdir(exist_ok=False)\nfor value in (os.environ[\"WHEEL\"], os.environ.get(\"\
        CATALOG\", \"\")):\n    if not value:\n        continue\n    path = root / value\n    if path.is_symlink() or not\
        \ path.is_file() or not path.resolve().is_relative_to(root):\n        raise SystemExit(\"Unsafe build asset\")\n \
        \   shutil.copyfile(path, out / path.name)\nPYTHON\n"
    - name: Retain exact build bytes
      uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9
      with:
        name: release-assets-vpngw-${{ github.run_id }}-${{ github.run_attempt }}
        path: ${{ runner.temp }}/ai-release-assets
        retention-days: 90
        if-no-files-found: error
    permissions:
      contents: read
