{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "scheduleName": {
      "type": "string",
      "minLength": 1
    },
    "bucket": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "endpoint": {
          "type": "string",
          "pattern": "^(|https://.+)"
        }
      }
    },
    "secret": {
      "type": "object",
      "required": ["name", "keys"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "keys": {
          "type": "object",
          "required": ["accessKeyID", "secretAccessKey", "backupPassword"],
          "properties": {
            "accessKeyID": { "type": "string", "minLength": 1 },
            "secretAccessKey": { "type": "string", "minLength": 1 },
            "backupPassword": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
