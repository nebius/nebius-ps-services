{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "dcgmHpcJobMappingDir": {
      "type": "string",
      "minLength": 1
    },
    "validateToolkit": { "type": "boolean" },
    "metricsPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "scrapeInterval": { "type": "string" },
        "scrapeTimeout": { "type": "string" }
      }
    }
  }
}
