{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "nfs": {
      "type": "object",
      "properties": {
        "sharedDirectory": { "type": "string", "minLength": 1 },
        "permitted": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "threads": { "type": "integer", "minimum": 1 }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "size": { "type": "string" },
        "accessMode": {
          "type": "string",
          "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany"]
        }
      }
    },
    "monitoring": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" }
          }
        }
      }
    }
  }
}
