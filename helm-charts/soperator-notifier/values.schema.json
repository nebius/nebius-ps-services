{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "slack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "existingSecret", "existingSecretKey"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["existing-webhook", "oauth-webhook"]
        },
        "existingSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 253
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "channelName": {
          "type": "string"
        },
        "channelId": {
          "type": "string"
        },
        "oauth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clientId": {
              "type": "string"
            },
            "redirectUri": {
              "type": "string"
            },
            "govSlack": {
              "type": "boolean"
            }
          }
        },
        "ignoreSystemJobs": {
          "type": "boolean"
        },
        "requireUserMail": {
          "type": "boolean"
        },
        "severityColor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "error": {
              "type": "string"
            },
            "warning": {
              "type": "string"
            },
            "good": {
              "type": "string"
            },
            "unknown": {
              "type": "string"
            }
          }
        }
      }
    },
    "alertManager": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,4}$"
            }
          ]
        }
      }
    },
    "dataSourceUrl": {
      "type": "string",
      "minLength": 1
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evaluation": {
          "type": "string",
          "pattern": "^(?:[0-9]+(?:ns|us|ms|s|m|h))+$"
        },
        "groupWait": {
          "type": "string",
          "pattern": "^(?:[0-9]+(?:ns|us|ms|s|m|h))+$"
        },
        "group": {
          "type": "string",
          "pattern": "^(?:[0-9]+(?:ns|us|ms|s|m|h))+$"
        },
        "repeat": {
          "type": "string",
          "pattern": "^(?:[0-9]+(?:ns|us|ms|s|m|h))+$"
        }
      }
    }
  }
}
