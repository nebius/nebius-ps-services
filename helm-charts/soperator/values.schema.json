{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "clusterName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 38,
      "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
    },
    "clusterType": {
      "type": "string",
      "enum": ["gpu", "cpu"]
    },
    "maintenance": {
      "type": "string",
      "enum": [
        "none",
        "downscale",
        "downscaleAndDeletePopulateJail",
        "downscaleAndOverwritePopulateJail",
        "skipPopulateJail"
      ]
    },
    "customSlurmConfig": {
      "type": "string",
      "not": {
        "pattern": "DefMemPerCPU\\s*="
      }
    },
    "partitionConfiguration": {
      "type": "object",
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "required": ["rawConfig"],
            "properties": {
              "rawConfig": { "minItems": 1 }
            }
          },
          "then": {
            "required": ["configType"],
            "properties": {
              "configType": { "const": "custom" }
            }
          }
        }
      ],
      "properties": {
        "configType": {
          "type": "string",
          "enum": ["default", "custom", "structured"]
        },
        "rawConfig": {
          "type": "array",
          "items": { "type": "string" }
        },
        "partitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "isAll": { "type": "boolean" },
              "nodeSetRefs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "config": { "type": "string" }
            }
          }
        }
      }
    },
    "mariadb-operator": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "installOperator": {
          "type": "boolean"
        }
      }
    },
    "uninstallCleanup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "pollIntervalSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "slurmNodes": {
      "type": "object",
      "properties": {
        "login": {
          "type": "object",
          "properties": {
            "sshRootPublicKeys": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)\\s+\\S+.*\\r?\\n?$"
              }
            }
          }
        },
        "sssd": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "image": { "type": "string" }
          }
        },
        "exporter": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "accountingJobsLookback": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h|d|w|y))+$"
            },
            "exporterContainer": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "resources": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "ephemeralStorage": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "volume": {
      "type": "object",
      "properties": {
        "jail": {
          "type": "object",
          "required": ["name", "size", "type"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "enum": ["filestore", "glusterfs", "local"] },
            "filestoreDeviceName": { "type": "string" },
            "localPath": { "type": "string" }
          }
        },
        "controllerSpool": {
          "type": "object",
          "required": ["name", "size"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "enum": ["filestore", "local"] },
            "filestoreDeviceName": { "type": "string" },
            "localPath": { "type": "string" }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mountImage": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        }
      }
    },
    "nodesets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "slurmd", "munge"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "slurmd": {
            "type": "object",
            "additionalProperties": true,
            "required": ["resources", "volumes"],
            "properties": {
              "resources": {
                "type": "object",
                "additionalProperties": true,
                "required": ["cpu", "memory"],
                "properties": {
                  "cpu": {
                    "oneOf": [
                      { "type": "string", "minLength": 1 },
                      { "type": "number" }
                    ]
                  },
                  "memory": { "type": "string", "minLength": 1 }
                }
              },
              "volumes": {
                "type": "object",
                "additionalProperties": true,
                "required": ["spool", "jail"],
                "properties": {
                  "spool": { "type": "object", "minProperties": 1 },
                  "jail": { "type": "object", "minProperties": 1 },
                  "customVolumeMounts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "munge": {
            "type": "object",
            "additionalProperties": true,
            "required": ["resources"],
            "properties": {
              "resources": {
                "type": "object",
                "additionalProperties": true,
                "required": ["cpu", "memory"],
                "properties": {
                  "cpu": {
                    "oneOf": [
                      { "type": "string", "minLength": 1 },
                      { "type": "number" }
                    ]
                  },
                  "memory": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "priorityClasses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 1000000000
          },
          "globalDefault": { "type": "boolean" },
          "preemptionPolicy": {
            "type": "string",
            "enum": ["Never", "PreemptLowerPriority"]
          }
        }
      }
    }
  }
}
