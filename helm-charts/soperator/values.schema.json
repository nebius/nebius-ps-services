{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "clusterName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 38,
      "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$"
    },
    "clusterType": {
      "type": "string",
      "enum": ["gpu", "cpu"]
    },
    "maintenance": {
      "type": "string",
      "enum": [
        "none",
        "downscale",
        "downscaleAndDeletePopulateJail",
        "skipPopulateJail"
      ]
    },
    "jailRootfs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["activePassive"]
        },
        "activeSlot": {
          "type": "string",
          "enum": ["slot-a", "slot-b"]
        },
        "passiveSlot": {
          "type": "string",
          "enum": ["slot-a", "slot-b"]
        },
        "slots": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slot-a", "slot-b"],
          "properties": {
            "slot-a": { "$ref": "#/definitions/jailRootfsSlot" },
            "slot-b": { "$ref": "#/definitions/jailRootfsSlot" }
          }
        },
        "adoption": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "activeSource": {
              "type": "string",
              "enum": ["slot", "legacy-rootfs"]
            },
            "rollbackSource": {
              "type": "string",
              "enum": ["legacy-rootfs"]
            },
            "legacyPvcName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
            }
          }
        }
      }
    },
    "jailPersistentMounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mountPath", "localPath"],
        "properties": {
          "mountPath": {
            "type": "string",
            "minLength": 2,
            "pattern": "^/[-A-Za-z0-9._/]+$"
          },
          "localPath": {
            "type": "string",
            "minLength": 2,
            "pattern": "^/[-A-Za-z0-9._/]+$"
          }
        }
      }
    },
    "gpuDriverJail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "customSlurmConfig": {
      "type": "string",
      "not": {
        "pattern": "DefMemPerCPU\\s*="
      }
    },
    "qosConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "string" },
        "imagePullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "hookWeight": { "type": "string" },
        "job": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "backoffLimit": { "type": "integer", "minimum": 0 },
            "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
            "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 },
            "resources": { "type": "object", "additionalProperties": true },
            "nodeSelector": { "type": "object", "additionalProperties": true },
            "tolerations": { "type": "array" },
            "affinity": { "type": "object", "additionalProperties": true },
            "k8sNodeFilterName": { "type": "string" }
          }
        },
        "preReconcileScript": { "type": "string" },
        "accounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "organization": { "type": "string" },
              "description": { "type": "string" },
              "parent": { "type": "string" }
            }
          }
        },
        "qos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "priority": { "type": ["integer", "null"], "minimum": 0 },
              "maxJobs": { "type": ["integer", "null"], "minimum": 0 },
              "maxWallSeconds": { "type": ["integer", "null"], "minimum": 1 },
              "maxTRES": { "type": "string" },
              "maxTRESPerJob": { "type": "string" },
              "flags": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "preempt": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "preemptMode": { "type": "string" }
            }
          }
        },
        "associations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["user", "account"],
            "properties": {
              "user": { "type": "string", "minLength": 1 },
              "account": { "type": "string", "minLength": 1 },
              "defaultQos": { "type": "string" },
              "qos": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "partition": { "type": "string" },
              "fairshare": { "type": "string" }
            }
          }
        }
      }
    },
    "schedulingConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preemptType": {
          "type": ["string", "null"],
          "enum": [
            null,
            "preempt/partition_prio",
            "preempt/qos",
            "preempt/none"
          ]
        },
        "accountingStorageEnforce": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "all",
              "associations",
              "limits",
              "nojobs",
              "nosteps",
              "qos",
              "safe",
              "wckeys"
            ]
          }
        },
        "enforcePartLimits": {
          "type": ["string", "null"],
          "enum": [null, "ALL", "ANY", "NO"]
        },
        "preemptMode": {
          "type": ["string", "null"],
          "pattern": "^(OFF|CANCEL|REQUEUE|SUSPEND|GANG)(,(OFF|CANCEL|REQUEUE|SUSPEND|GANG))*$"
        },
        "preemptParameters": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "jobRequeue": {
          "type": ["integer", "null"],
          "enum": [null, 0, 1]
        },
        "schedulerType": {
          "type": ["string", "null"],
          "enum": [null, "sched/backfill", "sched/builtin", "sched/hold"]
        },
        "schedulerParameters": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "priorityType": {
          "type": ["string", "null"],
          "enum": [null, "priority/basic", "priority/multifactor"]
        },
        "priorityWeights": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "age": { "type": ["integer", "null"], "minimum": 0 },
            "assoc": { "type": ["integer", "null"], "minimum": 0 },
            "fairshare": { "type": ["integer", "null"], "minimum": 0 },
            "partition": { "type": ["integer", "null"], "minimum": 0 },
            "jobSize": { "type": ["integer", "null"], "minimum": 0 },
            "qos": { "type": ["integer", "null"], "minimum": 0 },
            "tres": { "type": ["string", "null"] }
          }
        }
      }
    },
    "partitionConfiguration": {
      "type": "object",
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "required": ["rawConfig"],
            "properties": {
              "rawConfig": { "minItems": 1 }
            }
          },
          "then": {
            "required": ["configType"],
            "properties": {
              "configType": { "const": "custom" }
            }
          }
        }
      ],
      "properties": {
        "configType": {
          "type": "string",
          "enum": ["default", "custom", "structured"]
        },
        "includeFile": {
          "type": "string"
        },
        "rawConfig": {
          "type": "array",
          "items": { "type": "string" }
        },
        "partitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["name"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "isAll": { "type": "boolean" },
              "nodeSetRefs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "config": { "type": "string" },
              "policy": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "priorityTier": { "type": ["integer", "null"], "minimum": 0 },
                  "preemptMode": {
                    "type": ["string", "null"],
                    "pattern": "^(OFF|CANCEL|REQUEUE|SUSPEND|GANG)(,(OFF|CANCEL|REQUEUE|SUSPEND|GANG))*$"
                  },
                  "default": { "type": ["boolean", "null"] },
                  "hidden": { "type": ["boolean", "null"] },
                  "state": {
                    "type": ["string", "null"],
                    "enum": [null, "UP", "DOWN", "DRAIN", "INACTIVE"]
                  },
                  "maxTime": { "type": ["string", "null"], "minLength": 1 },
                  "defaultTime": { "type": ["string", "null"], "minLength": 1 },
                  "defMemPerNode": { "type": ["integer", "null"], "minimum": 0 },
                  "defMemPerCPU": { "type": ["integer", "null"], "minimum": 0 },
                  "defMemPerGPU": { "type": ["integer", "null"], "minimum": 0 },
                  "defCpuPerGPU": { "type": ["integer", "null"], "minimum": 0 },
                  "overSubscribe": {
                    "type": ["string", "null"],
                    "pattern": "^(NO|YES|EXCLUSIVE|FORCE)(:[0-9]+)?$"
                  },
                  "allowAccounts": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "allowQos": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "denyAccounts": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "denyQos": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "mariadb-operator": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "installOperator": {
          "type": "boolean"
        }
      }
    },
    "certManager": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "privateKey": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "rotationPolicy": {
              "type": "string",
              "enum": ["Always", "Never"]
            }
          }
        }
      }
    },
    "uninstallCleanup": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "timeoutSeconds": { "type": "integer", "minimum": 1 },
        "pollIntervalSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "customContainer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "env": { "type": "array" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "command": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "nodeSelector": { "type": "object", "additionalProperties": true },
        "resources": { "type": "object", "additionalProperties": true },
        "livenessProbe": { "type": "object", "additionalProperties": true },
        "readinessProbe": { "type": "object", "additionalProperties": true },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object", "additionalProperties": true },
        "priorityClassName": { "type": "string" },
        "serviceAccountName": { "type": "string" }
      }
    },
    "rebooter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "generateRBAC": { "type": "boolean" },
        "evictionMethod": { "type": "string", "minLength": 1 },
        "logLevel": { "type": "string" },
        "logFormat": { "type": "string" },
        "env": { "type": "array" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "nodeSelector": { "type": "object", "additionalProperties": true },
        "resources": { "type": "object", "additionalProperties": true },
        "livenessProbe": { "type": "object", "additionalProperties": true },
        "readinessProbe": { "type": "object", "additionalProperties": true },
        "tolerations": { "type": "array" },
        "affinity": { "type": "object", "additionalProperties": true },
        "priorityClassName": { "type": "string" },
        "serviceAccountName": { "type": "string" }
      }
    },
    "slurmNodes": {
      "type": "object",
      "properties": {
        "controller": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "openMetrics": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "enabled": { "type": "boolean" },
                "serviceMonitor": { "type": "object", "additionalProperties": true }
              }
            }
          }
        },
        "login": {
          "type": "object",
          "properties": {
            "sshRootPublicKeys": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(ssh-ed25519|ssh-rsa|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh.com|sk-ecdsa-sha2-nistp256@openssh.com)\\s+\\S+.*\\r?\\n?$"
              }
            }
          }
        },
        "sssd": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "image": { "type": "string" }
          }
        },
        "exporter": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "accountingJobsLookback": {
              "type": "string",
              "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h|d|w|y))+$"
            },
            "exporterContainer": {
              "type": "object",
              "additionalProperties": true,
              "properties": {
                "resources": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "ephemeralStorage": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "volume": {
      "type": "object",
      "properties": {
        "jail": {
          "type": "object",
          "required": ["name", "size", "type"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "enum": ["filestore", "glusterfs", "local"] },
            "filestoreDeviceName": { "type": "string" },
            "localPath": { "type": "string" }
          }
        },
        "controllerSpool": {
          "type": "object",
          "required": ["name", "size"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "size": { "type": "string", "minLength": 1 },
            "type": { "type": "string", "enum": ["filestore", "local"] },
            "filestoreDeviceName": { "type": "string" },
            "localPath": { "type": "string" }
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "mountImage": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "repository": { "type": "string", "minLength": 1 },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        }
      }
    },
    "slurmConfig": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "suspendTime": { "type": "integer", "minimum": 0 }
      }
    },
    "nodesets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name", "slurmd", "munge"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "replicas": { "type": "integer", "minimum": 0 },
          "ephemeralNodes": { "type": "boolean" },
          "initialNumberEphemeralNodes": { "type": "integer", "minimum": 0 },
          "ephemeralTopologyWaitTimeout": { "type": "integer", "minimum": 0 },
          "slurmd": {
            "type": "object",
            "additionalProperties": true,
            "required": ["resources", "volumes"],
            "properties": {
              "resources": {
                "type": "object",
                "additionalProperties": true,
                "required": ["cpu", "memory"],
                "properties": {
                  "cpu": {
                    "oneOf": [
                      { "type": "string", "minLength": 1 },
                      { "type": "number" }
                    ]
                  },
                  "memory": { "type": "string", "minLength": 1 }
                }
              },
              "volumes": {
                "type": "object",
                "additionalProperties": true,
                "required": ["spool"],
                "properties": {
                  "spool": { "type": "object", "minProperties": 1 },
                  "customVolumeMounts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          },
          "munge": {
            "type": "object",
            "additionalProperties": true,
            "required": ["resources"],
            "properties": {
              "resources": {
                "type": "object",
                "additionalProperties": true,
                "required": ["cpu", "memory"],
                "properties": {
                  "cpu": {
                    "oneOf": [
                      { "type": "string", "minLength": 1 },
                      { "type": "number" }
                    ]
                  },
                  "memory": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    },
    "priorityClasses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "value": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 1000000000
          },
          "globalDefault": { "type": "boolean" },
          "preemptionPolicy": {
            "type": "string",
            "enum": ["Never", "PreemptLowerPriority"]
          }
        }
      }
    }
  },
  "definitions": {
    "jailRootfsSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["volumeSourceName", "pvcName", "localPath"],
      "properties": {
        "volumeSourceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "pvcName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
        },
        "localPath": {
          "type": "string",
          "minLength": 2,
          "pattern": "^/[-A-Za-z0-9._/]+$"
        }
      }
    }
  }
}
