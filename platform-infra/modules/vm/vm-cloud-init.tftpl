#cloud-config
users:
  - name: ${ssh_user_name}
    gecos: Nebius VM User
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true
package_upgrade: true
packages:
  - openssh-server
  - ca-certificates
  - curl
  - gnupg

write_files:
  - path: /etc/ssh/sshd_config.d/50-nebius-vm.conf
    owner: root:root
    permissions: "0644"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      ChallengeResponseAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
      AuthenticationMethods publickey

%{ if observability_collector_enabled ~}
  - path: /usr/local/bin/bootstrap-observability-collector.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      export DEBIAN_FRONTEND=noninteractive
      export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

      install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://artifactory.nebius.dev/artifactory/nebius-o11y-agent/key.gpg -o /etc/apt/keyrings/o11y.gpg

      cat >/etc/apt/sources.list.d/nebius-o11y.list <<'EOF'
      deb [signed-by=/etc/apt/keyrings/o11y.gpg] https://artifactory.nebius.dev/artifactory/nebius-o11y-agent stable main
      EOF

      cat >/etc/apt/preferences.d/nebius-o11y-allowlist <<'EOF'
      Package: *
      Pin: origin "artifactory.nebius.dev"
      Pin-Priority: -1

      Package: nebius-o11y-agent
      Pin: origin "artifactory.nebius.dev"
      Pin-Priority: 1001
      EOF

      apt-get update
%{ if observability_collector_metrics_enabled ~}
      apt-get install -y "nebius-o11y-agent=${observability_collector_package_version}" prometheus
      systemctl disable --now prometheus.service >/dev/null 2>&1 || true
      install -m 0755 -d /var/lib/prometheus-cxcli-vm-agent
      chown prometheus:prometheus /var/lib/prometheus-cxcli-vm-agent
%{ else ~}
      apt-get install -y "nebius-o11y-agent=${observability_collector_package_version}"
%{ endif ~}
      install -m 0755 -d /etc/nebius-o11y-agent
      install -m 0755 -d /var/lib/nebius-o11y-agent
      install -m 0755 -d /var/lib/nebius-o11y-agent/journald

      systemctl daemon-reload
      systemctl enable --now nebius-o11y-agent@cxcli-vm-collector.service
%{ if observability_collector_metrics_enabled ~}
      systemctl enable --now cxcli-vm-prometheus-agent.service
%{ endif ~}

  - path: /etc/default/nebius-o11y-agent-cxcli-vm-collector
    owner: root:root
    permissions: "0644"
    content: |
      NEBIUS_O11Y_AGENT_ARGS="--config /etc/nebius-o11y-agent/cxcli-vm-collector.yaml"

  - path: /etc/nebius-o11y-agent/cxcli-vm-collector.yaml
    owner: root:root
    permissions: "0644"
    content: |
      extensions:
%{ if observability_collector_logs_enabled ~}
        file_storage/journald:
          directory: /var/lib/nebius-o11y-agent/journald
          timeout: 1s
          compaction:
            on_start: true
            on_rebound: true
            directory: /var/lib/nebius-o11y-agent/journald
%{ endif ~}
        nebiusiamauth:
          auth_scheme: iam-token-file
          iam_token_file: ${observability_collector_iam_token_file}

      receivers:
%{ if observability_collector_logs_enabled ~}
        journald:
          storage: file_storage/journald
          retry_on_failure:
            enabled: true
          start_at: end
          all: true
%{ if length(observability_collector_logs_systemd_units) > 0 ~}
          units:
%{ for unit_name in observability_collector_logs_systemd_units ~}
            - ${unit_name}
%{ endfor ~}
%{ endif ~}
          operators:
            - type: move
              from: body
              to: attributes["attrs"]
            - type: flatten
              field: attributes["attrs"]
            - type: move
              from: attributes["MESSAGE"]
              to: body
            - type: severity_parser
              parse_from: attributes.PRIORITY
              preset: none
              if: '"PRIORITY" in attributes'
              mapping:
                fatal:
                  - min: 0
                    max: 2
                error: 3
                warning: 4
                info:
                  - min: 5
                    max: 6
                debug: 7
            - type: remove
              field: attributes.PRIORITY
              if: '"PRIORITY" in attributes'
%{ endif ~}
%{ if observability_collector_metrics_enabled ~}
        nodeexporter:
          enabled_collectors:
            - cpu
            - diskstats
            - filesystem
            - loadavg
            - meminfo
            - netdev
            - os
            - stat
            - time
            - vmstat
%{ endif ~}

      processors:
        batch:
          send_batch_size: 500
          timeout: 5s
        memory_limiter:
          check_interval: 1s
          limit_mib: 256
%{ if observability_collector_logs_enabled ~}
        transform/cxcli-vm-logs:
          log_statements:
            - context: resource
              statements:
                - set(attributes["vm_name"], "${vm_name}")
                - set(attributes["project_id"], "${project_id}")
                - set(attributes["collector"], "cxcli-vm-collector")
%{ endif ~}

      exporters:
%{ if observability_collector_logs_enabled ~}
        otlp/logs:
          endpoint: dns:///write.logging.${observability_collector_region_id}.nebius.cloud:443
          balancer_name: round_robin
          timeout: 30s
          auth:
            authenticator: nebiusiamauth
          headers:
            project-id: "${project_id}"
%{ endif ~}
%{ if observability_collector_metrics_enabled ~}
        prometheus:
          endpoint: 127.0.0.1:${observability_collector_metrics_export_port}
%{ endif ~}

      service:
        extensions:
%{ if observability_collector_logs_enabled ~}
          - file_storage/journald
%{ endif ~}
          - nebiusiamauth
        telemetry:
          logs:
            level: "info"
            disable_stacktrace: true
        pipelines:
%{ if observability_collector_logs_enabled ~}
          logs:
            receivers:
              - journald
            processors:
              - memory_limiter
              - batch
              - transform/cxcli-vm-logs
            exporters:
              - otlp/logs
%{ endif ~}
%{ if observability_collector_metrics_enabled ~}
          metrics:
            receivers:
              - nodeexporter
            processors:
              - memory_limiter
              - batch
            exporters:
              - prometheus
%{ endif ~}

%{ if observability_collector_metrics_enabled ~}
  - path: /etc/prometheus/cxcli-vm-agent.yml
    owner: root:root
    permissions: "0644"
    content: |
      global:
        scrape_interval: 30s
        external_labels:
          project_id: "${project_id}"
          vm_name: "${vm_name}"
          collector: "cxcli-vm-collector"

      scrape_configs:
        - job_name: "cxcli-vm-collector"
          static_configs:
            - targets:
                - "127.0.0.1:${observability_collector_metrics_export_port}"

      remote_write:
        - url: "https://write.monitoring.${observability_collector_region_id}.nebius.cloud/projects/${project_id}/prometheus/api/v1/write"
          authorization:
            type: Bearer
            credentials_file: "${observability_collector_iam_token_file}"

  - path: /etc/systemd/system/cxcli-vm-prometheus-agent.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Prometheus agent for cxcli VM observability collector
      After=network-online.target nebius-o11y-agent@cxcli-vm-collector.service
      Wants=network-online.target

      [Service]
      Type=simple
      User=prometheus
      Group=prometheus
      ExecStart=/usr/bin/prometheus --config.file=/etc/prometheus/cxcli-vm-agent.yml --storage.agent.path=/var/lib/prometheus-cxcli-vm-agent --web.listen-address=127.0.0.1:${observability_collector_prometheus_agent_port} --enable-feature=agent
      Restart=on-failure
      RestartSec=5s

      [Install]
      WantedBy=multi-user.target
%{ endif ~}
%{ endif ~}

%{ if container_enabled ~}
  - path: /usr/local/bin/bootstrap-vm.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      export DEBIAN_FRONTEND=noninteractive
      export PATH="/usr/sbin:/usr/bin:/sbin:/bin"

      install -m 0755 -d /etc/apt/keyrings
      if [ ! -f /etc/apt/keyrings/docker.gpg ]; then
        curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
      fi

      . /etc/os-release
      printf 'deb [arch=%s signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu %s stable\n' \
        "$(dpkg --print-architecture)" "$${VERSION_CODENAME}" > /etc/apt/sources.list.d/docker.list

      apt-get update
      apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

%{ if container_use_gpu ~}
      if [ ! -f /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg ]; then
        curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey | gpg --dearmor --yes -o /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
      fi
      distribution="$${ID}$${VERSION_ID}"
      curl -fsSL "https://nvidia.github.io/libnvidia-container/$${distribution}/libnvidia-container.list" | \
        sed 's#deb https://#deb [signed-by=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg] https://#g' > /etc/apt/sources.list.d/nvidia-container-toolkit.list
      apt-get update
      apt-get install -y nvidia-container-toolkit
      nvidia-ctk runtime configure --runtime=docker
%{ endif ~}

      usermod -aG docker ${ssh_user_name}
      systemctl daemon-reload
      systemctl enable --now docker
%{ if container_use_gpu ~}
      systemctl restart docker
%{ endif ~}
      systemctl enable --now bootstrap-container.service

  - path: /usr/local/bin/run-bootstrap-container.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      args=(
        run
        --detach
        --restart
        "${container_restart_policy}"
        --name
        "${container_name}"
      )
%{ if container_use_gpu ~}
      args+=(--gpus all)
%{ endif ~}
%{ for port in container_ports ~}
      args+=(-p "${port.host_port}:${port.container_port}/${lower(port.protocol)}")
%{ endfor ~}
%{ for key, value in container_env ~}
      args+=(-e "${key}=${value}")
%{ endfor ~}
%{ for mount in container_mounts ~}
      args+=(-v "${mount.host_path}:${mount.container_path}${mount.read_only ? ":ro" : ""}")
%{ endfor ~}
%{ if container_entrypoint != null ~}
      args+=(--entrypoint "${container_entrypoint}")
%{ endif ~}
      args+=("${container_image}")
%{ for arg in container_args ~}
      args+=("${arg}")
%{ endfor ~}

      /usr/bin/docker pull "${container_image}"
      /usr/bin/docker rm -f "${container_name}" >/dev/null 2>&1 || true
      exec /usr/bin/docker "$${args[@]}"

  - path: /usr/local/bin/stop-bootstrap-container.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      /usr/bin/docker stop "${container_name}" >/dev/null 2>&1 || true
      /usr/bin/docker rm -f "${container_name}" >/dev/null 2>&1 || true

  - path: /etc/systemd/system/bootstrap-container.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Managed bootstrap container for ${container_name}
      Requires=docker.service
      After=network-online.target docker.service
      Wants=network-online.target

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/bin/run-bootstrap-container.sh
      ExecStop=/usr/local/bin/stop-bootstrap-container.sh
      TimeoutStartSec=0

      [Install]
      WantedBy=multi-user.target
%{ endif ~}

runcmd:
  - [ bash, -lc, "sshd -t && (systemctl enable --now ssh || systemctl enable --now sshd)" ]
%{ if observability_collector_enabled ~}
  - [ bash, -lc, "/usr/local/bin/bootstrap-observability-collector.sh > /var/log/bootstrap-observability-collector.log 2>&1" ]
%{ endif ~}
%{ if container_enabled ~}
  - [ bash, -lc, "/usr/local/bin/bootstrap-vm.sh > /var/log/bootstrap-vm.log 2>&1" ]
%{ endif ~}
