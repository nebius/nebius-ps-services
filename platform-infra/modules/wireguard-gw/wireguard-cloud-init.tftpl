#cloud-config
ssh_deletekeys: true
ssh_genkeytypes: []
ssh_pwauth: false
disable_root: true
bootcmd:
  - [ cloud-init-per, once, wg-ssh-quarantine, sh, -c, "systemctl mask --runtime --now ssh.service; systemctl disable --now ssh.socket; systemctl mask ssh.socket" ]
users:
  - name: ${ssh_user_name}
    gecos: WireGuard Administration User
    groups: [sudo]
    shell: /bin/bash
    lock_passwd: true

package_update: true
package_upgrade: true
packages:
  - wireguard
  - wireguard-tools
  - openssh-server
  - ufw
  - fail2ban
  - unattended-upgrades
  - auditd
  - curl
  - ca-certificates
  - python3

write_files:
  - path: /etc/nebius-wireguard/access.json
    owner: root:root
    permissions: "0600"
    content: |
      ${access_config_json}
  - path: /usr/local/sbin/nebius-wireguard-access
    owner: root:root
    permissions: "0700"
    content: |
      ${access_helper}
  - path: /etc/systemd/system/nebius-wireguard-access.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Validate pinned WireGuard SSH identity before administrator access
      After=network-online.target
      Wants=network-online.target
      Before=ssh.service
      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/nebius-wireguard-access bootstrap
      RemainAfterExit=yes
      UMask=0077
      [Install]
      WantedBy=multi-user.target
  - path: /etc/systemd/system/ssh.service.d/wireguard-access.conf
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Requires=nebius-wireguard-access.service
      After=nebius-wireguard-access.service
      [Service]
      ExecStartPre=
      ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/sshd_config.d/50-wireguard-gw.conf
      ExecStart=
      ExecStart=/usr/sbin/sshd -D -f /etc/ssh/sshd_config.d/50-wireguard-gw.conf
  - path: /etc/systemd/system/nebius-wireguard-setup.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Complete and resume WireGuard gateway first-boot setup
      After=network-online.target
      Wants=network-online.target
      StartLimitIntervalSec=0
      [Service]
      Type=oneshot
      ExecStart=/usr/local/bin/setup-wireguard.sh
      RemainAfterExit=yes
      Restart=on-failure
      RestartSec=15
      UMask=0077
      [Install]
      WantedBy=multi-user.target
  - path: /etc/ssh/sshd_config.d/50-wireguard-gw.conf
    owner: root:root
    permissions: "0644"
    content: |
      HostKey /etc/ssh/cxcli_wireguard_host_ed25519_key
      AuthorizedKeysFile /etc/ssh/cxcli-wireguard-authorized-keys
      AllowUsers ${ssh_user_name}
      Port 22
      AddressFamily any
      ListenAddress 0.0.0.0
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      ChallengeResponseAuthentication no
      PubkeyAuthentication yes
      AuthenticationMethods publickey
      PermitEmptyPasswords no
      UsePAM yes
      X11Forwarding no
      AllowAgentForwarding no
      AllowTcpForwarding no
      GatewayPorts no
      PermitTunnel no
      PermitUserEnvironment no
      MaxAuthTries 3
      LoginGraceTime 30
      ClientAliveInterval 300
      ClientAliveCountMax 2
      MaxStartups 10:30:60
      LogLevel VERBOSE
      AcceptEnv LANG LC_*

  - path: /etc/fail2ban/jail.d/sshd.conf
    owner: root:root
    permissions: "0644"
    content: |
      [sshd]
      enabled = true
      port = ssh
      backend = systemd
      maxretry = 3
      findtime = 600
      bantime = 3600
      banaction = ufw

  - path: /etc/audit/rules.d/50-wireguard-gw.rules
    owner: root:root
    permissions: "0640"
    content: |
      -w /etc/ssh/ -p wa -k ssh_config
      -w /etc/sudoers -p wa -k sudoers
      -w /etc/sudoers.d/ -p wa -k sudoers
      -w /etc/passwd -p wa -k identity
      -w /etc/shadow -p wa -k identity
      -w /etc/group -p wa -k identity
      -w /etc/gshadow -p wa -k identity
      -w /etc/wireguard/ -p wa -k wireguard_config
      -w /etc/nebius-wireguard/ -p wa -k wireguard_config
      -w /var/lib/nebius-wireguard/ -p wa -k wireguard_state

  - path: /etc/apt/apt.conf.d/50unattended-upgrades
    owner: root:root
    permissions: "0644"
    content: |
      Unattended-Upgrade::Allowed-Origins {
          "$${distro_id}:$${distro_codename}-security";
      };
      Unattended-Upgrade::Automatic-Reboot "false";
      Unattended-Upgrade::Automatic-Reboot-Time "02:00";

  - path: /etc/sudoers.d/90-${ssh_user_name}
    owner: root:root
    permissions: "0440"
    content: |
      ${ssh_user_name} ALL=(ALL) NOPASSWD:ALL

  - path: /usr/local/sbin/nebius-wireguard-client
    owner: root:root
    permissions: "0755"
    content: |
      ${network_helper}

  - path: /usr/local/bin/setup-wireguard.sh
    owner: root:root
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      export PATH="/usr/sbin:/usr/bin:/sbin:/bin"
      if [ "$EUID" -ne 0 ]; then
        echo "setup-wireguard.sh must run as root" >&2
        exit 1
      fi

      for cmd in wg wg-quick ip iptables ufw sysctl python3 sshd systemctl fail2ban-client augenrules; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
          echo "required command not found: $cmd" >&2
          exit 1
        fi
      done

      if [ -f /var/lib/nebius-wireguard/access/setup-complete ]; then
        exit 0
      fi
      install -d -m 0700 /etc/nebius-wireguard
      if [ ! -f /etc/nebius-wireguard/config.json ]; then
      cat > /etc/nebius-wireguard/config.json <<'EOF'
      ${wireguard_config_json}
      EOF
      chmod 0600 /etc/nebius-wireguard/config.json
      fi

      cat > /etc/nebius-wireguard/bootstrap-clients.json <<'EOF'
      ${bootstrap_clients_json}
      EOF
      chmod 0600 /etc/nebius-wireguard/bootstrap-clients.json

      systemctl daemon-reload
      systemctl enable nebius-wireguard-access.service
      systemctl start nebius-wireguard-access.service
      systemctl mask --now ssh.socket
      systemctl unmask --runtime ssh.service
      /usr/local/sbin/nebius-wireguard-client init-server
      /usr/local/sbin/nebius-wireguard-client bootstrap --clients-file /etc/nebius-wireguard/bootstrap-clients.json
      systemctl is-active --quiet wg-quick@wg0.service
      /usr/local/sbin/nebius-wireguard-access setup-complete

runcmd:
  - [ systemctl, daemon-reload ]
  - [ systemctl, enable, --now, nebius-wireguard-setup.service ]
