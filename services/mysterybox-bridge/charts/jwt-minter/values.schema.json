{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "enabled": { "type": "boolean" },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "pullPolicy"],
      "anyOf": [
        {
          "properties": {
            "tag": { "type": "string", "minLength": 1 }
          }
        },
        {
          "properties": {
            "digest": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "global": {
      "type": "object",
      "properties": {
        "partOf": { "type": "string" },
        "labels": { "type": "object" },
        "annotations": { "type": "object" },
        "imagePullSecrets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "schedule": { "type": "string", "minLength": 1 },
    "concurrencyPolicy": {
      "type": "string",
      "enum": ["Allow", "Forbid", "Replace"]
    },
    "startingDeadlineSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "successfulJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "failedJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "sourceSecret": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" }
      },
      "required": ["optional"]
    },
    "outputSecret": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string" }
      },
      "required": ["name", "key"]
    },
    "job": {
      "type": "object",
      "properties": {
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 1 }
      }
    },
    "tmpDir": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "mountPath": { "type": "string", "minLength": 1 }
      },
      "required": ["enabled", "mountPath"]
    },
    "resources": {
      "type": "object"
    },
    "token": {
      "type": "object",
      "properties": {
        "ttlSeconds": { "type": "integer", "minimum": 1 },
        "refreshBeforeSeconds": { "type": "integer", "minimum": 0 },
        "clockSkewSeconds": { "type": "integer", "minimum": 0 }
      },
      "required": ["ttlSeconds", "refreshBeforeSeconds", "clockSkewSeconds"]
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": { "type": "object" }
    },
    "affinity": {
      "type": "object"
    }
  }
}
