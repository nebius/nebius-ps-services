{
  "uid": "cxcli-kubernetes-gpu",
  "title": "Nebius Kubernetes GPU Metrics",
  "tags": [
    "nebius",
    "kubernetes",
    "gpu",
    "cxcli"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "Cluster",
        "label": "Cluster",
        "type": "query",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "nebius-service-metrics"
        },
        "query": "query_result(count by (mk8s_cluster_id) (DCGM_FI_DEV_GPU_UTIL{job=\"nebius-observability-agent\"}))",
        "regex": "/.*mk8s_cluster_id=\"([^\"}]+)\".*/",
        "refresh": 1,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "current": {
          "text": "",
          "value": ""
        },
        "options": []
      },
      {
        "name": "GpuNode",
        "label": "GPU Node",
        "type": "query",
        "hide": 0,
        "query": "query_result(count by (instance_id) (DCGM_FI_DEV_GPU_UTIL{job=\"nebius-observability-agent\",mk8s_cluster_id=~\"$Cluster\"}))",
        "datasource": {
          "type": "prometheus",
          "uid": "nebius-service-metrics"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": ".*"
        },
        "options": [],
        "allValue": ".*",
        "regex": "/.*instance_id=\"([^\"}]+)\".*/"
      },
      {
        "name": "Gpu",
        "label": "GPU UUID",
        "type": "query",
        "hide": 0,
        "query": "query_result(count by (uuid) (DCGM_FI_DEV_GPU_UTIL{job=\"nebius-observability-agent\",mk8s_cluster_id=~\"$Cluster\",instance_id=~\"$GpuNode\"}))",
        "datasource": {
          "type": "prometheus",
          "uid": "nebius-service-metrics"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": ".*"
        },
        "options": [],
        "allValue": ".*",
        "regex": "/.*uuid=\"([^\"}]+)\".*/"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU Nodes",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nebius-service-metrics"
      },
      "targets": [
        {
          "expr": "count(count by (instance_id) (DCGM_FI_DEV_GPU_UTIL{job=\"nebius-observability-agent\",mk8s_cluster_id=~\"$Cluster\",instance_id=~\"$GpuNode\",uuid=~\"$Gpu\"}))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nebius-service-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "GPUs",
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nebius-service-metrics"
      },
      "targets": [
        {
          "expr": "count(count by (uuid) (DCGM_FI_DEV_GPU_UTIL{job=\"nebius-observability-agent\",mk8s_cluster_id=~\"$Cluster\",instance_id=~\"$GpuNode\",uuid=~\"$Gpu\"}))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nebius-service-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Average GPU Utilization",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nebius-service-metrics"
      },
      "targets": [
        {
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL{job=\"nebius-observability-agent\",mk8s_cluster_id=~\"$Cluster\",instance_id=~\"$GpuNode\",uuid=~\"$Gpu\"}) / 100",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nebius-service-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "GPU Memory Used",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nebius-service-metrics"
      },
      "targets": [
        {
          "expr": "sum(DCGM_FI_DEV_FB_USED{job=\"nebius-observability-agent\",mk8s_cluster_id=~\"$Cluster\",instance_id=~\"$GpuNode\",uuid=~\"$Gpu\"})",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nebius-service-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Power Usage",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nebius-service-metrics"
      },
      "targets": [
        {
          "expr": "sum(DCGM_FI_DEV_POWER_USAGE{job=\"nebius-observability-agent\",mk8s_cluster_id=~\"$Cluster\",instance_id=~\"$GpuNode\",uuid=~\"$Gpu\"})",
