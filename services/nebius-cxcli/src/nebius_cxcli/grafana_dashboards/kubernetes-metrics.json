{
  "uid": "cxcli-kubernetes-metrics",
  "title": "Nebius Kubernetes Metrics",
  "tags": [
    "nebius",
    "kubernetes",
    "cxcli"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "Cluster",
        "label": "Cluster",
        "type": "query",
        "hide": 0,
        "query": "query_result(count by (\"k8s.cluster.id\") (container_cpu_usage_seconds_total))",
        "datasource": {
          "type": "prometheus",
          "uid": "nebius-user-metrics"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "All",
          "value": ".*"
        },
        "options": [],
        "regex": "/(?s).*\"k8s.cluster.id\"=\"([^\"}]+)\".*/"
      },
      {
        "name": "Node",
        "label": "Node",
        "type": "query",
        "hide": 0,
        "query": "query_result(count by (kubernetes_io_hostname) (container_cpu_usage_seconds_total{\"k8s.cluster.id\"=~\"$Cluster\",pod!=\"\"}))",
        "datasource": {
          "type": "prometheus",
          "uid": "nebius-user-metrics"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": ".*"
        },
        "options": [],
        "allValue": ".*",
        "regex": "/.*kubernetes_io_hostname=\"([^\"}]+)\".*/"
      },
      {
        "name": "Namespace",
        "label": "Namespace",
        "type": "query",
        "hide": 0,
        "query": "label_values(container_cpu_usage_seconds_total{\"k8s.cluster.id\"=~\"$Cluster\",kubernetes_io_hostname=~\"$Node\",pod!=\"\",namespace!=\"\"}, namespace)",
        "datasource": {
          "type": "prometheus",
          "uid": "nebius-user-metrics"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": ".*"
        },
        "options": [],
        "allValue": ".*"
      },
      {
        "name": "Pod",
        "label": "Pod",
        "type": "query",
        "hide": 0,
        "query": "label_values(container_cpu_usage_seconds_total{\"k8s.cluster.id\"=~\"$Cluster\",kubernetes_io_hostname=~\"$Node\",namespace=~\"$Namespace\",pod!=\"\"}, pod)",
        "datasource": {
          "type": "prometheus",
          "uid": "nebius-user-metrics"
        },
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": ".*"
        },
        "options": [],
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "nebius-user-metrics"
      },
      "targets": [
        {
          "expr": "count(count by (kubernetes_io_hostname) (container_cpu_usage_seconds_total{\"k8s.cluster.id\"=~\"$Cluster\",kubernetes_io_hostname=~\"$Node\",namespace=~\"$Namespace\",pod=~\"$Pod\",pod!=\"\"}))",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nebius-user-metrics"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto"
      }
    },
    {
