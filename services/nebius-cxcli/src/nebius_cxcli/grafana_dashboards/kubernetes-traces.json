{
  "uid": "cxcli-kubernetes-traces",
  "title": "Nebius Kubernetes Traces",
  "tags": [
    "nebius",
    "kubernetes",
    "traces",
    "cxcli"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Trace Ingestion",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Trace panels use generic TraceQL so the dashboard works across workloads. Data appears after applications emit OTLP traces through the Nebius Observability Agent."
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Recent Traces",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "nebius-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{}",
          "limit": 50,
          "datasource": {
            "type": "tempo",
            "uid": "nebius-traces"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "type": "table",
      "title": "Slow Traces (>1s)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "nebius-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ duration > 1s }",
          "limit": 20,
          "datasource": {
            "type": "tempo",
            "uid": "nebius-traces"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Error Traces",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "tempo",
        "uid": "nebius-traces"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ status = error }",
          "limit": 20,
          "datasource": {
            "type": "tempo",
            "uid": "nebius-traces"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    }
  ]
}
