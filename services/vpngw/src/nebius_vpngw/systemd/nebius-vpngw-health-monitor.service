[Unit]
Description=Nebius VPN Tunnel Health Monitor
Documentation=https://github.com/nebius-ps-services/vpngw
After=network.target strongswan-starter.service frr.service
Wants=strongswan-starter.service frr.service

[Service]
Type=simple
# Load from YAML config file (reads defaults.health_monitoring section)
ExecStart=/usr/bin/python3 -m nebius_vpngw.agent.tunnel_health_monitor --config /etc/nebius-vpngw/config-resolved.yaml

# Alternative configurations (uncomment ONE of these if needed):
#
# Option 1: Manual intervals without config file
# ExecStart=/usr/bin/python3 -m nebius_vpngw.agent.tunnel_health_monitor --check-interval 60
#
# Option 2: Proactive refresh mode (restart every 8 hours regardless of health)
# ExecStart=/usr/bin/python3 -m nebius_vpngw.agent.tunnel_health_monitor --check-interval 60 --proactive-refresh --refresh-hours 8
#
# Option 3: Custom intervals
# ExecStart=/usr/bin/python3 -m nebius_vpngw.agent.tunnel_health_monitor --check-interval 30 --refresh-hours 12

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nebius-vpngw-health

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=nebius-vpngw
RuntimeDirectoryMode=0755
ReadWritePaths=/var/log /run/nebius-vpngw
# Need CAP_NET_ADMIN to restart IPsec tunnels
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
