[Unit]
Description=Nebius VPN gateway management and VPN ingress admission
DefaultDependencies=no
After=local-fs.target
Before=network-pre.target ufw.service ssh.service ssh.socket nebius-vpngw-agent.service nebius-vpngw-vm-ha.service
Wants=network-pre.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/lib/nebius-vpngw-ingress.py apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
