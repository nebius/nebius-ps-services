[Unit]
Description=Nebius VPNGW persistent physical-route preparation
After=network-online.target nebius-vpngw-vm-ha-guard.service
Wants=network-online.target
Before=strongswan.service frr.service nebius-vpngw-agent.service nebius-vpngw-vm-ha.service
ConditionPathExists=/etc/nebius-vpngw/config-resolved.yaml

[Service]
Type=oneshot
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 -m nebius_vpngw.agent.underlay
RemainAfterExit=yes
TimeoutStartSec=60
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
RuntimeDirectory=nebius-vpngw
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=nebius-vpngw
ReadWritePaths=/etc/systemd/network /var/lib/nebius-vpngw /run/nebius-vpngw
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
