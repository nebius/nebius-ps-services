[Unit]
Description=Nebius VPNGW VM-HA cold-start forwarding guard
DefaultDependencies=no
After=local-fs.target systemd-sysctl.service systemd-tmpfiles-setup.service
Before=network-online.target strongswan-starter.service strongswan.service frr.service nebius-vpngw-agent.service nebius-vpngw-vm-ha.service
ConditionPathExists=/etc/nebius-vpngw/vm-ha-enabled

[Service]
Type=oneshot
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 -m nebius_vpngw.agent.main --vm-ha-guard
RemainAfterExit=yes
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
RuntimeDirectory=nebius-vpngw
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ReadWritePaths=/var/lib/nebius-vpngw /run/nebius-vpngw /proc/sys/net/ipv4/ip_forward
AmbientCapabilities=CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
