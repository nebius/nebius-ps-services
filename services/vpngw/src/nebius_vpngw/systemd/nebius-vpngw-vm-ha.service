[Unit]
Description=Nebius VPNGW VM-HA controller
After=network-online.target nebius-vpngw-vm-ha-guard.service
Requires=nebius-vpngw-vm-ha-guard.service
Before=strongswan-starter.service strongswan.service frr.service nebius-vpngw-agent.service
ConditionPathExists=/etc/nebius-vpngw/vm-ha-enabled

[Service]
Type=simple
Environment="PYTHONUNBUFFERED=1"
ExecStartPre=/usr/bin/python3 -m nebius_vpngw.agent.main --vm-ha-preflight
ExecStart=/usr/bin/python3 -m nebius_vpngw.agent.main --vm-ha-controller
Restart=no
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nebius-vpngw /run/nebius-vpngw /proc/sys/net/ipv4/ip_forward
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
