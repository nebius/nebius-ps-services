{
  "playwright": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@playwright/mcp@0.0.81",
      "--headless",
      "--browser",
      "chrome",
      "--isolated"
    ]
  },
  "terraform": {
    "type": "stdio",
    "command": "docker",
    "args": [
      "run",
      "-i",
      "--rm",
      "hashicorp/terraform-mcp-server:0.5.2"
    ]
  },
  "markitdown": {
    "type": "stdio",
    "command": "uvx",
    "args": [
      "markitdown-mcp==0.0.1a4"
    ]
  },
  "microsoftdocs": {
    "type": "http",
    "url": "https://learn.microsoft.com/api/mcp"
  },
  "github": {
    "type": "http",
    "url": "https://api.githubcopilot.com/mcp/",
    "headers": {
      "Authorization": "Bearer ${GITHUB_TOKEN}"
    }
  },
  "openaiDeveloperDocs": {
    "type": "http",
    "url": "https://developers.openai.com/mcp"
  },
  "tavily": {
    "type": "stdio",
    "command": "<ABSOLUTE_NODE>",
    "args": ["<TAVILY_RUNTIME>/node_modules/mcp-remote/dist/proxy.js", "https://mcp.tavily.com/mcp/", "37412", "--transport", "http-only", "--auth-timeout", "300", "--silent"],
    "env": {"MCP_REMOTE_CONFIG_DIR": "<TAVILY_AUTH_DIR>"}
  },
  "nebiusDocs": {
    "type": "http",
    "url": "https://docs.nebius.com/mcp"
  }
}
