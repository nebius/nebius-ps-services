#:schema https://developers.openai.com/codex/config-schema.json
#
# Public-safe Codex recovery template.
#
# This is a reviewed, portable recovery baseline derived from a local Codex
# setup without copying that live file. Replace {{CODEX_HOME}} and
# {{PROJECT_ROOT}} when rendering this file for a real user. Do not commit
# rendered local files.
#
# Intentionally omitted: personal project lists, absolute local paths, secret
# values, shell-environment overrides, notification commands, private or
# plugin-managed MCP servers, plugin/marketplace state, desktop preferences,
# inline hook state, generated notice/TUI state, and undocumented feature keys.
# Restore those through their owning setup flow after reviewing the target
# machine. See references/config-recovery.md.

model = "gpt-5.6-sol"
model_reasoning_effort = "xhigh"
plan_mode_reasoning_effort = "xhigh"
service_tier = "fast"
approval_policy = "never"
sandbox_mode = "danger-full-access"
web_search = "live"
personality = "pragmatic"

# Optional, only when Tavily OAuth and OS credential storage are selected:
# mcp_oauth_credentials_store = "keyring"

[features]
shell_tool = true
hooks = true
multi_agent = true
memories = true
fast_mode = true

[agents]
max_concurrent_threads_per_session = 16

[agents.repo_mapper]
description = "Read-only codebase explorer for relevant files, symbols, execution paths, dependencies, and conventions."
nickname_candidates = ["Mapper", "Pathfinder", "Scout"]
config_file = "agents/repo_mapper.toml"

[agents.test_strategist]
description = "Read-only verification planner for tests, fixtures, CI commands, local commands, and validation gaps."
nickname_candidates = ["Verifier", "Test Scout", "Checkmate"]
config_file = "agents/test_strategist.toml"

[agents.risk_reviewer]
description = "Read-only reviewer focused on correctness, regressions, security, compatibility, edge cases, and missing tests."
nickname_candidates = ["Reviewer", "Sentinel", "Auditor"]
config_file = "agents/risk_reviewer.toml"

[sandbox_workspace_write]
network_access = true
# Keep implement execution state opt-in. When sandbox_mode is
# workspace-write and the user requests it, append
# "{{CODEX_HOME}}/implement" without removing existing roots.
writable_roots = ["{{CODEX_HOME}}/task-state"]

[mcp_servers.playwright]
command = "npx"
args = ["-y", "@playwright/mcp@0.0.81", "--headless", "--browser", "chrome", "--isolated"]

[mcp_servers.terraform]
command = "docker"
args = ["run", "-i", "--rm", "hashicorp/terraform-mcp-server:0.5.2"]

[mcp_servers.markitdown]
command = "uvx"
args = ["markitdown-mcp==0.0.1a4"]
startup_timeout_sec = 30.0

[mcp_servers.microsoftdocs]
url = "https://learn.microsoft.com/api/mcp"

[mcp_servers.github]
url = "https://api.githubcopilot.com/mcp/"
bearer_token_env_var = "GITHUB_TOKEN"

[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"

[mcp_servers.nebiusDocs]
url = "https://docs.nebius.com/mcp"

# Add only the trusted project roots the user explicitly reviews.
[projects."{{PROJECT_ROOT}}"]
trust_level = "trusted"

[projects."{{CODEX_HOME}}"]
trust_level = "trusted"

# Optional Tavily OAuth integration; enable only when explicitly selected.
# Then run: codex mcp login tavily
# [mcp_servers.tavily]
# url = "https://mcp.tavily.com/mcp/"
