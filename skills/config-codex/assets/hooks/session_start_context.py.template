#!/usr/bin/env python3
"""Inject global context and restore private session state when available."""

from __future__ import annotations

import json
import os
import sys

from global_context_state import (
    TaskStateError,
    codex_home,
    prepare_state_file,
    resolve_root,
    state_file_for_payload,
)


def read_payload() -> dict:
    try:
        return json.load(sys.stdin)
    except Exception:
        return {}


def main() -> int:
    payload = read_payload()
    cwd = payload.get("cwd") or os.getcwd()
    root = resolve_root(cwd)
    home = codex_home()
    state_file = state_file_for_payload(root, payload, home)
    if state_file is None:
        task_state_context = """Durable task-state file: unavailable (hook payload missing session_id)

No session-scoped task-state path is available for this session. Continue
without creating a manual fallback path or repo-local state file.
"""
    else:
        try:
            state_status = prepare_state_file(
                state_file,
                home=home,
                create=payload.get("source") == "compact",
            )
        except (TaskStateError, OSError):
            task_state_context = """Durable task-state file: unavailable (private initialization failed)

Continue without durable task state for this session. Do not create a manual
fallback path or repo-local state file.
"""
        else:
            if state_status == "created":
                state_note = (
                    "Compaction initialized an empty private state scaffold. "
                    "Reconstruct and write a concise rolling summary before continuing."
                )
            elif state_status == "existing":
                state_note = (
                    "An existing private task-state file is available. Read it when "
                    "prior decisions may matter."
                )
            else:
                state_note = (
                    "SessionStart advertises this path without creating it. The first "
                    "complex prompt initializes an empty private scaffold."
                )
            task_state_context = f"""Durable task-state file: `{state_file}`

{state_note} Keep current.md as a rolling summary, not an append-only transcript.
"""

    context = f"""Global context is available.

Workspace root: `{root}`
{task_state_context}
Keep raw logs, secrets, and broad exploration output out of durable task state.
Replace stale task-state details instead of appending transcripts.
Use project skills for workflow-specific instructions.
"""

    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "SessionStart",
                    "additionalContext": context,
                }
            }
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
