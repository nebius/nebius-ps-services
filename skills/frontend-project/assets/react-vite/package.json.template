{
  "name": "{{PACKAGE_NAME}}",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "{{PACKAGE_MANAGER}}@{{PACKAGE_MANAGER_VERSION}}",
  "engines": {
    "node": {{NODE_RANGE_JSON}}
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "react": "{{REACT_VERSION}}",
    "react-dom": "{{REACT_DOM_VERSION}}"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "{{TESTING_LIBRARY_JEST_DOM_VERSION}}",
    "@testing-library/react": "{{TESTING_LIBRARY_REACT_VERSION}}",
    "@types/node": "{{NODE_TYPES_VERSION}}",
    "@types/react": "{{REACT_TYPES_VERSION}}",
    "@types/react-dom": "{{REACT_DOM_TYPES_VERSION}}",
    "@vitejs/plugin-react": "{{VITE_REACT_PLUGIN_VERSION}}",
    "jsdom": "{{JSDOM_VERSION}}",
    "typescript": "{{TYPESCRIPT_VERSION}}",
    "vite": "{{VITE_VERSION}}",
    "vitest": "{{VITEST_VERSION}}"
  }
}
