name: __PROJECT_NAME__-ci

on:
  pull_request:
    paths:
      - "__APP_DIR__/**"
      - ".github/workflows/__PROJECT_NAME__-ci.yml"
      - ".github/workflows/__PROJECT_NAME__-release.yml"
  push:
    branches: ["__MAIN_BRANCH__"]
    paths:
      - "__APP_DIR__/**"
      - ".github/workflows/__PROJECT_NAME__-ci.yml"
      - ".github/workflows/__PROJECT_NAME__-release.yml"
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: __PROJECT_NAME__-ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  verify:
    name: __PROJECT_NAME__-ci
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: __APP_DIR__
    steps:
      - name: Checkout
        uses: actions/checkout@v6
        with:
          fetch-depth: 0

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: "__PYTHON_VERSION__"

      # Replace these commands when the service is not Python-based.
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]"

      - name: Lint
        run: python -m ruff check src tests

      - name: Test
        run: python -m pytest -q

      - name: Build artifact
        run: |
          rm -rf build dist
          python -m build --wheel
