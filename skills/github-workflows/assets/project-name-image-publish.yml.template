name: __PROJECT_NAME__-image-publish

on:
  push:
    tags:
      - "__PROJECT_TAG_PREFIX__-v*"
  workflow_dispatch:
    inputs:
      source_ref:
        description: "Git ref (branch, tag, or SHA) to build"
        required: false
        default: "__MAIN_BRANCH__"
        type: string
      publish_latest:
        description: "Also publish :latest (recommended only for __MAIN_BRANCH__)"
        required: false
        default: false
        type: boolean

permissions:
  contents: read
  actions: read

concurrency:
  group: image-${{ github.repository }}-__IMAGE_NAME__
  cancel-in-progress: false
  queue: max

env:
  MAIN_BRANCH: __MAIN_BRANCH__
  IMAGE_NAME: __IMAGE_NAME__
  APP_DIR: __APP_DIR__
  REGISTRY_HOST: __REGISTRY_HOST__

jobs:
  test:
    if: github.event_name == 'push' || github.ref == 'refs/heads/__MAIN_BRANCH__'
    outputs:
      commit: ${{ steps.source.outputs.commit }}
    name: __PROJECT_NAME__-lint-and-test
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: ${{ env.APP_DIR }}
    steps:
      - name: Checkout
        uses: actions/checkout@v6
        with:
          ref: ${{ inputs.source_ref || github.ref }}

      - name: Freeze tested source
        id: source
        run: echo "commit=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: "__PYTHON_VERSION__"

      # Replace these commands if the service is not Python-based.
      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -e ".[dev]"

      - name: Lint
        run: python -m ruff check src tests

      - name: Test
        run: python -m pytest -q tests

  build-and-push:
    name: __PROJECT_NAME__-build-and-push
    runs-on: ubuntu-latest
    needs: [test]
    environment:
      name: __PUBLISH_ENVIRONMENT__
    steps:
      - name: Checkout trusted publication owner
        uses: actions/checkout@v7
        with:
          ref: ${{ github.sha }}
          path: .publication-owner
          persist-credentials: false
      - name: Freeze helper from workflow revision
        run: cp .publication-owner/.github/scripts/publication.py "$RUNNER_TEMP/publication.py"
      - name: Checkout
        uses: actions/checkout@v6
        with:
          ref: ${{ needs.test.outputs.commit }}
          fetch-depth: 0

      - name: Ensure tag commit belongs to main history
        run: |
          set -euo pipefail
          git fetch origin "__MAIN_BRANCH__:refs/remotes/origin/__MAIN_BRANCH__" --prune
          if ! git merge-base --is-ancestor "${{ needs.test.outputs.commit }}" "origin/__MAIN_BRANCH__"; then
            echo "::error::Tag commit ${GITHUB_SHA} is not in origin/__MAIN_BRANCH__ history"
            exit 1
          fi

      - name: Authorize workflow_dispatch actor
        if: github.event_name == 'workflow_dispatch'
        uses: actions/github-script@v9
        with:
          script: |
            const { owner, repo } = context.repo;
            const username = context.actor;
            const response = await github.rest.repos.getCollaboratorPermissionLevel({
              owner,
              repo,
              username,
            });
            const permission = response.data.permission;
            core.info(`workflow_dispatch actor '${username}' permission: ${permission}`);
            if (permission !== "admin") {
              core.setFailed(
                `workflow_dispatch publish is restricted to repository admins; actor '${username}' has '${permission}'.`
              );
            }

      - name: Validate workflow_dispatch inputs
        if: github.event_name == 'workflow_dispatch'
        env:
          SOURCE_REF: ${{ inputs.source_ref }}
          PUBLISH_LATEST: ${{ inputs.publish_latest }}
        run: |
          set -euo pipefail

          if [[ "${PUBLISH_LATEST}" == "true" && "${SOURCE_REF}" != "__MAIN_BRANCH__" ]]; then
            echo "::error::publish_latest=true is only allowed with source_ref=__MAIN_BRANCH__"
            exit 1
          fi

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v4

      - name: Resolve registry credentials
        id: registry_creds
        env:
          REGISTRY_SECRET: ${{ secrets.__REGISTRY_SECRET_NAME__ }}
          REGISTRY_USERNAME_VAR: ${{ vars.__REGISTRY_USERNAME_VAR_NAME__ }}
        run: |
          set -euo pipefail

          if [ -z "${REGISTRY_SECRET:-}" ]; then
            echo "::error::Missing required secret __REGISTRY_SECRET_NAME__"
            exit 1
          fi

          if [[ "${REGISTRY_SECRET}" == *":"* ]]; then
            echo "username=${REGISTRY_SECRET%%:*}" >> "$GITHUB_OUTPUT"
            echo "password=${REGISTRY_SECRET#*:}" >> "$GITHUB_OUTPUT"
          else
            username="${REGISTRY_USERNAME_VAR:-}"
            if [[ -z "${username}" ]]; then
              echo "::error::Token-only secret requires variable __REGISTRY_USERNAME_VAR_NAME__"
              exit 1
            fi
            echo "username=${username}" >> "$GITHUB_OUTPUT"
            echo "password=${REGISTRY_SECRET}" >> "$GITHUB_OUTPUT"
          fi

      - name: Login to registry
        uses: docker/login-action@v4
        with:
          registry: ${{ env.REGISTRY_HOST }}
          username: ${{ steps.registry_creds.outputs.username }}
          password: ${{ steps.registry_creds.outputs.password }}

      - name: Resolve image tags
        id: image_tags
        env:
          EVENT_NAME: ${{ github.event_name }}
          REF_NAME: ${{ github.ref_name }}
          PUBLISH_LATEST: ${{ inputs.publish_latest }}
        run: |
          set -euo pipefail
          commit="$(git rev-parse HEAD)"
          short_sha="${commit::7}"
          release_tag=""
          if [[ "$EVENT_NAME" == push ]]; then
            if [[ ! "$REF_NAME" =~ ^__PROJECT_TAG_PREFIX__-v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]]; then
              echo 'Invalid release tag.' >&2
              exit 1
            fi
            version="${REF_NAME#__PROJECT_TAG_PREFIX__-v}"
            tags="${IMAGE_NAME}:${version}"$'\n'"${IMAGE_NAME}:${version}-g${short_sha}"
            release_tag="$REF_NAME"
          else
            tags="${IMAGE_NAME}:sha-${short_sha}"
            if [[ "$PUBLISH_LATEST" == true ]]; then
              tags="${tags}"$'\n'"${IMAGE_NAME}:latest"
            fi
          fi
          {
            echo "commit=$commit"
            echo "release_tag=$release_tag"
            echo 'tags<<EOF'
            echo "$tags"
            echo 'EOF'
          } >> "$GITHUB_OUTPUT"

      - name: Check all immutable image aliases
        id: existing
        env:
          PUBLISH_LATEST: ${{ inputs.publish_latest }}
          GH_TOKEN: ${{ github.token }}
          TAGS: ${{ steps.image_tags.outputs.tags }}
          RELEASE_TAG: ${{ steps.image_tags.outputs.release_tag }}
          SOURCE_COMMIT: ${{ steps.image_tags.outputs.commit }}
        run: >-
          python3 "$RUNNER_TEMP/publication.py" image-state --workflow __PROJECT_NAME__-image-publish.yml
          --commit "$SOURCE_COMMIT" --tag "$RELEASE_TAG"

      - name: Build and push image
        if: steps.existing.outputs.publish_needed == 'true'
        id: build
        uses: docker/build-push-action@v7
        with:
          context: ${{ env.APP_DIR }}
          file: ${{ env.APP_DIR }}/Dockerfile
          push: true
          provenance: mode=max
          sbom: true
          tags: ${{ steps.image_tags.outputs.tags }}
          cache-from: type=gha
          cache-to: type=gha,mode=max

      - name: Update explicitly requested latest from verified digest
        if: steps.existing.outputs.latest_needed == 'true'
        env:
          LATEST_REF: ${{ steps.existing.outputs.latest_ref }}
          VERIFIED_SOURCE: ${{ steps.existing.outputs.verified_source }}
        run: docker buildx imagetools create --prefer-index=false --tag "$LATEST_REF" "$VERIFIED_SOURCE"

      - name: Verify every remote tag digest
        env:
          TAGS: ${{ steps.image_tags.outputs.tags }}
          IMAGE_DIGEST: ${{ steps.build.outputs.digest || steps.existing.outputs.digest }}
        run: python3 "$RUNNER_TEMP/publication.py" image-verify

      - name: Record verified image identity
        if: steps.existing.outputs.publish_needed == 'true' || steps.existing.outputs.latest_needed == 'true'
        env:
          TAGS: ${{ steps.image_tags.outputs.tags }}
          IMAGE_DIGEST: ${{ steps.build.outputs.digest || steps.existing.outputs.digest }}
          RELEASE_TAG: ${{ steps.image_tags.outputs.release_tag }}
          SOURCE_COMMIT: ${{ steps.image_tags.outputs.commit }}
        run: >-
          python3 "$RUNNER_TEMP/publication.py" image-manifest --workflow __PROJECT_NAME__-image-publish.yml
          --commit "$SOURCE_COMMIT" --tag "$RELEASE_TAG" --output publication.json

      - name: Preserve immutable image evidence
        if: steps.existing.outputs.publish_needed == 'true' || steps.existing.outputs.latest_needed == 'true'
        uses: actions/upload-artifact@v7
        with:
          name: publication-image-${{ github.run_id }}-${{ github.run_attempt }}
          path: publication.json
          retention-days: 90
          if-no-files-found: error

      - name: Upload publish manifest artifact
        if: steps.existing.outputs.publish_needed == 'true'
        uses: actions/upload-artifact@v7
        with:
          name: __PROJECT_NAME__-image-publish-manifest-${{ github.run_id }}
          path: publication.json
          if-no-files-found: error

      - name: Publish run summary
        env:
          TAGS: ${{ steps.image_tags.outputs.tags }}
          IMAGE_DIGEST: ${{ steps.build.outputs.digest || steps.existing.outputs.digest }}
        run: |
          {
            echo "### __PROJECT_NAME__ image publish"
            echo ""
            echo "- Actor: \`${GITHUB_ACTOR}\`"
            echo "- Event: \`${GITHUB_EVENT_NAME}\`"
            echo "- Ref: \`${GITHUB_REF}\`"
            echo "- Commit: \`${{ steps.image_tags.outputs.commit }}\`"
            echo "- Digest: \`${IMAGE_DIGEST}\`"
            echo ""
            echo "#### Tags"
            while IFS= read -r tag; do
              [ -n "${tag}" ] && echo "- \`${tag}\`"
            done <<< "${TAGS}"
          } >> "$GITHUB_STEP_SUMMARY"
