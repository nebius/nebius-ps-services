name: dependabot-auto-merge

on:
  pull_request_target:
    types: [opened, reopened, synchronize, ready_for_review]

permissions:
  contents: read
  pull-requests: read

concurrency:
  group: dependabot-admission-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  admission:
    name: dependency-admission
    if: >-
      github.actor_id == '49699333' &&
      github.event.pull_request.user.id == 49699333 &&
      github.event.pull_request.head.repo.full_name == github.repository &&
      github.event.pull_request.base.ref == github.event.repository.default_branch &&
      github.event.pull_request.draft == false
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      # No checkout, secrets, write token or merge effects in this event.
      - name: Verify Dependabot metadata
        id: metadata
        uses: dependabot/fetch-metadata@25dd0e34f4fe68f24cc83900b1fe3fe149efef98 # v3
        with:
          github-token: ${{ github.token }}
      - name: Record exact admission identity
        env:
          PACKAGE_ECOSYSTEM: ${{ steps.metadata.outputs.package-ecosystem }}
          UPDATE_TYPE: ${{ steps.metadata.outputs.update-type }}
        run: |
          python3 - <<'PYTHON'
          import json, os
          from pathlib import Path
          event = json.loads(Path(os.environ['GITHUB_EVENT_PATH']).read_text())
          pr = event['pull_request']
          result = {
              'schema': 'dependabot-admission/v1',
              'repository': os.environ['GITHUB_REPOSITORY'],
              'pr': pr['number'], 'head': pr['head']['sha'],
              'base': pr['base']['ref'], 'base_sha': os.environ['GITHUB_SHA'],
              'run_id': int(os.environ['GITHUB_RUN_ID']),
              'ecosystem': os.environ['PACKAGE_ECOSYSTEM'],
              'update_type': os.environ['UPDATE_TYPE'],
          }
          Path('admission.json').write_text(json.dumps(result))
          PYTHON
      - uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        with:
          name: dependabot-${{ github.event.pull_request.number }}-${{ github.event.pull_request.head.sha }}
          path: admission.json
          retention-days: 30
          if-no-files-found: error
