name: Merge completion
run-name: "Merge completion: ${{ inputs.source_run_id || github.event.workflow_run.id || github.event_name }} / ${{ inputs.source_run_attempt || github.event.workflow_run.run_attempt }}"
on:
  workflow_run:
    workflows: ["Protected merge"]
    types: [completed]
  schedule:
    - cron: '17 * * * *'
  workflow_dispatch:
    inputs:
      source_run_id:
        description: Verified result producer run (requires source_run_attempt)
        type: string
        required: false
      source_run_attempt:
        description: Verified result producer attempt (requires source_run_id)
        type: string
        required: false
permissions:
  contents: read
  pull-requests: read
  actions: read
jobs:
  recovery-ci-targets:
    name: recovery-ci-targets
    if: >-
      github.ref == format('refs/heads/{0}', github.event.repository.default_branch) &&
      (github.event_name == 'schedule' || (github.event_name == 'workflow_dispatch' && inputs.source_run_id == '' && inputs.source_run_attempt == ''))
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      ci_targets: ${{ steps.plan.outputs.ci_targets }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - id: plan
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          set -euo pipefail
          targets=$(python3 .github/scripts/merge_gate.py ci-targets --recovery)
          printf 'ci_targets=%s\n' "$targets" >> "$GITHUB_OUTPUT"
  repair-ci-status:
    name: required-ci-status
    needs: recovery-ci-targets
    if: >-
      github.ref == format('refs/heads/{0}', github.event.repository.default_branch) &&
      needs.recovery-ci-targets.outputs.ci_targets != '[]'
    strategy:
      fail-fast: false
      matrix:
        target: ${{ fromJSON(needs.recovery-ci-targets.outputs.ci_targets) }}
    environment: github-ai-automation
    runs-on: ubuntu-latest
    timeout-minutes: 10
    permissions:
      contents: read
      pull-requests: read
      actions: read
      checks: read
      statuses: write
    concurrency:
      group: required-ci-${{ github.repository }}-${{ matrix.target.pr }}
      cancel-in-progress: false
    env:
      AI_AUTOMATION_PR_REVIEW: ${{ vars.AI_AUTOMATION_PR_REVIEW || 'disabled' }}
      AI_AUTOMATION_MERGE_FORK_CONTRIBUTION: ${{ vars.AI_AUTOMATION_MERGE_FORK_CONTRIBUTION || 'false' }}
      AI_AUTOMATION_STATE_BUCKET: ${{ secrets.AI_AUTOMATION_STATE_BUCKET }}
      AI_AUTOMATION_STATE_ENDPOINT: ${{ secrets.AI_AUTOMATION_STATE_ENDPOINT }}
      AI_AUTOMATION_STATE_ACCESS_KEY_ID: ${{ secrets.AI_AUTOMATION_STATE_ACCESS_KEY_ID }}
      AI_AUTOMATION_STATE_SECRET_ACCESS_KEY: ${{ secrets.AI_AUTOMATION_STATE_SECRET_ACCESS_KEY }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.sha }}
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          version: '0.13.7'
          enable-cache: false
      - env:
          GH_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ matrix.target.pr }}
          PR_HEAD: ${{ matrix.target.head }}
        run: uv run --locked --project github-ai-automation python .github/scripts/merge_gate.py publish-ci --pr "$PR_NUMBER" --head "$PR_HEAD"

  candidates:
    name: completion-candidates
    if: >-
      github.ref == format('refs/heads/{0}', github.event.repository.default_branch) &&
      (github.event_name != 'workflow_run' ||
        (github.event.workflow_run.event == 'workflow_dispatch' &&
          github.event.workflow_run.path == '.github/workflows/skills-merge-pr.yml'))
    runs-on: ubuntu-latest
    timeout-minutes: 10
    outputs:
      targets: ${{ steps.plan.outputs.targets }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false
      - id: plan
        env:
          GH_TOKEN: ${{ github.token }}
          MERGE_OPERATOR_IDS: ${{ vars.MERGE_OPERATOR_IDS }}
        run: |
          set -euo pipefail
          status=0
          targets=$(python3 .github/scripts/merge_completion.py targets) || status=$?
          if [ "$status" -ne 0 ]; then
            printf 'Completion candidate discovery failed (exit %s).\n' "$status" >&2
            if [ -n "$targets" ]; then printf '%s\n' "$targets" >&2; fi
            exit "$status"
          fi
          printf 'targets=%s\n' "$targets" >> "$GITHUB_OUTPUT"
  dispatch:
    name: dispatch-result-ci
    needs: candidates
    if: needs.candidates.outputs.targets != '[]'
    strategy:
      fail-fast: false
      matrix:
        target: ${{ fromJSON(needs.candidates.outputs.targets) }}
    concurrency:
      group: result-ci-${{ github.repository }}-${{ matrix.target.pr }}
      cancel-in-progress: false
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read
      actions: write
    env:
      GH_TOKEN: ${{ github.token }}
      MERGE_OPERATOR_IDS: ${{ vars.MERGE_OPERATOR_IDS }}
      PR_NUMBER: ${{ matrix.target.pr }}
      PR_HEAD: ${{ matrix.target.head }}
      BROKER_RUN: ${{ matrix.target.run_id }}
      BROKER_ATTEMPT: ${{ matrix.target.run_attempt }}
    steps:
      - name: Report blocked recovery target
        if: matrix.target.blocked == true
        run: |
          echo 'Target receipt is invalid or unavailable; maintainer reconciliation required.' >&2
          exit 1
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false
      - name: Freeze dispatch attempts before effects
        id: journal
        run: |
          python3 .github/scripts/merge_completion.py prepare-dispatch --pr "$PR_NUMBER" \
            --head "$PR_HEAD" --run-id "$BROKER_RUN" --run-attempt "$BROKER_ATTEMPT" \
            --output "$RUNNER_TEMP/dispatch.json"
      - name: Preserve uncertain dispatch recovery
        id: dispatch-journal
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        with:
          name: merge-dispatch-${{ matrix.target.pr }}-${{ steps.journal.outputs.result_sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/dispatch.json
          retention-days: 30
          if-no-files-found: error
      - name: Reconcile and dispatch exact-result CI
        env:
          DISPATCH_ARTIFACT_ID: ${{ steps.dispatch-journal.outputs.artifact-id }}
        run: |
          python3 .github/scripts/merge_completion.py dispatch --pr "$PR_NUMBER" \
            --head "$PR_HEAD" --run-id "$BROKER_RUN" --run-attempt "$BROKER_ATTEMPT" \
            --dispatch-record "$RUNNER_TEMP/dispatch.json"
  pages:
    name: verify-pages-${{ matrix.target.pr }}
    needs: [candidates, dispatch]
    if: always() && needs.candidates.result == 'success' && needs.candidates.outputs.targets != '[]'
    strategy:
      fail-fast: false
      matrix:
        target: ${{ fromJSON(needs.candidates.outputs.targets) }}
    concurrency:
      group: merge-pages-${{ github.repository }}
      cancel-in-progress: false
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: read
      pull-requests: read
      actions: read
      pages: write
    env:
      GH_TOKEN: ${{ github.token }}
      MERGE_OPERATOR_IDS: ${{ vars.MERGE_OPERATOR_IDS }}
      PR_NUMBER: ${{ matrix.target.pr }}
      PR_HEAD: ${{ matrix.target.head }}
      BROKER_RUN: ${{ matrix.target.run_id }}
      BROKER_ATTEMPT: ${{ matrix.target.run_attempt }}
    steps:
      - name: Block invalid recovery target
        if: matrix.target.blocked == true
        run: exit 1
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          persist-credentials: false
      - name: Prepare Pages request without publication effects
        id: pages-journal
        run: |
          status=0
          python3 .github/scripts/merge_completion.py prepare-pages --pr "$PR_NUMBER" \
            --head "$PR_HEAD" --run-id "$BROKER_RUN" --run-attempt "$BROKER_ATTEMPT" \
            --output "$RUNNER_TEMP/pages.json" || status=$?
          if [ "$status" != 0 ] && [ "$status" != 2 ]; then exit "$status"; fi
      - name: Preserve Pages request recovery
        id: pages-intent
        if: steps.pages-journal.outputs.ready == 'true'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        with:
          name: merge-pages-${{ matrix.target.pr }}-${{ steps.pages-journal.outputs.result_sha }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/pages.json
          retention-days: 30
          if-no-files-found: error
      - name: Verify CI and reconcile Pages publication
        if: steps.pages-journal.outputs.ready == 'true'
        env:
          PAGES_ARTIFACT_ID: ${{ steps.pages-intent.outputs.artifact-id }}
        id: completion
        run: |
          status=0
          python3 .github/scripts/merge_completion.py pages --request --pr "$PR_NUMBER" \
            --head "$PR_HEAD" --run-id "$BROKER_RUN" --run-attempt "$BROKER_ATTEMPT" \
            --pages-record "$RUNNER_TEMP/pages.json" --output "$RUNNER_TEMP/completion.json" || status=$?
          if [ "$status" != 0 ] && [ "$status" != 2 ]; then exit "$status"; fi
      - name: Preserve terminal completion evidence
        if: steps.completion.outputs.complete == 'true'
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7
        with:
          name: merge-complete-${{ matrix.target.pr }}-${{ matrix.target.head }}-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/completion.json
          retention-days: 30
          if-no-files-found: error
