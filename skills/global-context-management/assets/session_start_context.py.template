#!/usr/bin/env python3
"""Inject a global task-state path at Codex session start.

This hook does not create a task-state scaffold for every session. It only
advertises the session-scoped path and repairs permissions when a prior
task-state file already exists.
"""

from __future__ import annotations

import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys


def read_payload() -> dict:
    try:
        return json.load(sys.stdin)
    except Exception:
        return {}


def resolve_root(cwd: str) -> str:
    cwd = os.path.abspath(cwd)

    try:
        root = subprocess.check_output(
            ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except Exception:
        root = ""

    return os.path.abspath(root or cwd)


def safe_segment(value: str) -> str:
    safe = re.sub(r"[^A-Za-z0-9._-]+", "-", value).strip("-")
    return safe[:80]


def chmod_private(path: Path, mode: int) -> None:
    try:
        path.chmod(mode)
    except OSError:
        pass


def task_state_path_for_payload(root: str, payload: dict) -> Path | None:
    codex_home = Path(os.environ.get("CODEX_HOME", Path.home() / ".codex"))
    codex_home = codex_home.expanduser()

    workspace_name = safe_segment(Path(root).name or "workspace") or "workspace"
    workspace_hash = hashlib.sha256(root.encode("utf-8")).hexdigest()[:12]
    session_id = payload.get("session_id")
    if not session_id:
        return None
    session_segment = safe_segment(str(session_id))
    if not session_segment:
        return None

    state_dir = (
        codex_home
        / "task-state"
        / f"{workspace_name}-{workspace_hash}"
        / session_segment
    )

    state_path = state_dir / "current.md"
    if state_path.exists():
        chmod_private(codex_home / "task-state", 0o700)
        chmod_private(state_dir.parent, 0o700)
        chmod_private(state_dir, 0o700)
        chmod_private(state_path, 0o600)

    return state_path


def main() -> int:
    payload = read_payload()
    cwd = payload.get("cwd") or os.getcwd()
    root = resolve_root(cwd)
    state_file = task_state_path_for_payload(root, payload)
    if state_file is None:
        task_state_context = """Durable task-state file: unavailable (hook payload missing session_id)

No session-scoped task-state path is available for this session. Continue
without creating a manual fallback path or repo-local state file.
"""
    else:
        task_state_context = f"""Durable task-state file: `{state_file}`

SessionStart only advertises this path; it does not create task-state, SDLC run
state, or workflow state. If the file already exists, read it when prior
decisions may matter. Keep current.md as a rolling summary, not an append-only
transcript.
"""

    context = f"""Global context is available.

Workspace root: `{root}`
{task_state_context}
Keep raw logs, secrets, and broad exploration output out of durable task state.
Replace stale task-state details instead of appending transcripts.
Use project skills for workflow-specific instructions.
"""

    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "SessionStart",
                    "additionalContext": context,
                }
            }
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
