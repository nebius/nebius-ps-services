#!/usr/bin/env python3
"""Inject global context-management guidance for complex prompts."""

from __future__ import annotations

import json
import os
from pathlib import Path
import re
import stat
import sys

from global_context_state import (
    TaskStateError,
    codex_home,
    prepare_state_file,
    resolve_root,
    state_file_for_payload,
    workspace_state_dir,
)

try:
    import tomllib
except ModuleNotFoundError:  # pragma: no cover - for older Python hook hosts.
    tomllib = None


MAX_RELATED_STATE_FILES = 3
MAX_RELATED_STATE_SCAN_FILES = 30
MAX_RELATED_STATE_SCAN_BYTES = 12_000
MAX_PROMPT_TERMS = 32

STOP_TERMS = {
    "about",
    "after",
    "again",
    "also",
    "and",
    "are",
    "can",
    "codex",
    "commands",
    "constraints",
    "could",
    "current",
    "decisions",
    "does",
    "files",
    "for",
    "from",
    "has",
    "have",
    "hygiene",
    "how",
    "into",
    "make",
    "made",
    "not",
    "now",
    "objective",
    "please",
    "plan",
    "relevant",
    "risks",
    "run",
    "should",
    "state",
    "status",
    "summary",
    "symbols",
    "task",
    "task-state",
    "test",
    "that",
    "the",
    "then",
    "there",
    "this",
    "when",
    "where",
    "with",
    "work",
    "workspace",
    "works",
}

CONTINUATION_TERMS = {
    "continue",
    "continuation",
    "previous",
    "prior",
    "proceed",
    "resume",
    "same",
}


COMPLEX_KEYWORDS = (
    "implement",
    "refactor",
    "debug",
    "fix",
    "migrate",
    "migration",
    "architecture",
    "design",
    "test",
    "tests",
    "review",
    "align",
    "standardize",
    "harden",
    "hardening",
    "plan",
    "investigate",
    "workflow",
    "ci",
    "failing",
    "failure",
    "error",
    "stack trace",
    "multi-file",
    "multiple files",
    "performance",
    "security",
    "concurrency",
    "race",
    "deadlock",
    "regression",
    "root cause",
    "root-cause",
)

def read_payload() -> dict:
    try:
        return json.load(sys.stdin)
    except Exception:
        return {}


def looks_complex(prompt: str) -> bool:
    lower = prompt.lower()
    return len(prompt) >= 300 or any(keyword in lower for keyword in COMPLEX_KEYWORDS)


def prompt_terms(text: str) -> set[str]:
    terms: list[str] = []
    seen: set[str] = set()
    for raw in re.findall(r"[a-z0-9][a-z0-9_.-]{1,}", text.lower()):
        term = raw.strip("._-")
        if (
            len(term) < 3
            or term in STOP_TERMS
            or term in CONTINUATION_TERMS
            or term in seen
        ):
            continue
        terms.append(term)
        seen.add(term)
        if len(terms) >= MAX_PROMPT_TERMS:
            break
    return set(terms)


def is_continuation_prompt(prompt: str) -> bool:
    terms = set(re.findall(r"[a-z0-9][a-z0-9_.-]{1,}", prompt.lower()))
    return bool(terms & CONTINUATION_TERMS)


def read_state_sample(path: Path) -> str:
    try:
        if path.is_symlink() or not stat.S_ISREG(path.lstat().st_mode):
            return ""
        with path.open("r", encoding="utf-8", errors="replace") as handle:
            return handle.read(MAX_RELATED_STATE_SCAN_BYTES)
    except OSError:
        return ""


def related_task_state_candidates(
    *,
    root: str,
    payload: dict,
    prompt: str,
    home: Path,
) -> list[Path]:
    workspace_dir = workspace_state_dir(root, home)
    try:
        if workspace_dir.is_symlink() or not stat.S_ISDIR(
            workspace_dir.lstat().st_mode
        ):
            return []
        workspace_root = workspace_dir.resolve(strict=True)
    except OSError:
        return []

    current_state = state_file_for_payload(root, payload, home)
    prompt_words = prompt_terms(prompt)
    continuation_prompt = is_continuation_prompt(prompt)
    if not prompt_words:
        return []

    candidates: list[tuple[int, float, Path]] = []
    try:
        paths = []
        for session_dir in workspace_dir.iterdir():
            if session_dir.is_symlink() or not stat.S_ISDIR(
                session_dir.lstat().st_mode
            ):
                continue
            state_path = session_dir / "current.md"
            if state_path.is_symlink() or not stat.S_ISREG(state_path.lstat().st_mode):
                continue
            if not state_path.resolve(strict=True).is_relative_to(workspace_root):
                continue
            paths.append(state_path)
        paths.sort(key=lambda item: item.lstat().st_mtime, reverse=True)
    except OSError:
        return []

    for path in paths[:MAX_RELATED_STATE_SCAN_FILES]:
        if current_state is not None:
            try:
                if path.resolve() == current_state.resolve():
                    continue
            except OSError:
                if path == current_state:
                    continue
        try:
            if path.is_symlink() or not stat.S_ISREG(path.lstat().st_mode):
                continue
            mtime = path.lstat().st_mtime
        except OSError:
            continue

        sample = read_state_sample(path)
        overlap = prompt_words & prompt_terms(sample)
        if not overlap:
            continue
        score = len(overlap) * 10 + (1 if continuation_prompt else 0)
        candidates.append((score, mtime, path))

    candidates.sort(key=lambda item: (item[0], item[1]), reverse=True)
    return [path for _, _, path in candidates[:MAX_RELATED_STATE_FILES]]


def related_task_state_context(root: str, payload: dict, prompt: str, home: Path) -> str:
    candidates = related_task_state_candidates(
        root=root,
        payload=payload,
        prompt=prompt,
        home=home,
    )
    if not candidates:
        return ""

    lines = ["Related same-workspace task-state candidates (not loaded):"]
    for path in candidates:
        lines.append(f"- `{path}`")
    lines.append(
        "Read only the candidate(s) that appear relevant to the current task; "
        "treat them as stale hints and verify against current repo/runtime evidence."
    )
    return "\n".join(lines) + "\n"


def read_json_file(path: Path) -> dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def read_toml_file(path: Path) -> dict:
    if tomllib is None:
        return {}
    try:
        data = tomllib.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {}
    return data if isinstance(data, dict) else {}


def truthy(value: object, default: bool = False) -> bool:
    if isinstance(value, bool):
        return value
    if isinstance(value, str):
        return value.strip().lower() in {"1", "true", "yes", "on"}
    return default


def delegation_policy(home: Path) -> dict:
    return read_json_file(home / "hooks" / "global_context_policy.json")


def auto_subagents_enabled(policy: dict) -> bool:
    return truthy(policy.get("auto_read_only_subagents")) or truthy(
        policy.get("enabled")
    )


def is_relative_to(path: Path, parent: Path) -> bool:
    try:
        path.resolve().relative_to(parent.resolve())
    except ValueError:
        return False
    except OSError:
        return False
    return True


def safe_agent_name(name: object) -> str:
    if not isinstance(name, str):
        return ""
    if re.fullmatch(r"[A-Za-z0-9_.-]{1,80}", name):
        return name
    return ""


def compact_text(value: object, max_length: int = 160) -> str:
    if not isinstance(value, str):
        return ""
    text = re.sub(r"\s+", " ", value).strip().replace("`", "'")
    return text[:max_length]


def agent_config_path(home: Path, name: str, spec: dict) -> Path:
    config_file = spec.get("config_file")
    if isinstance(config_file, str) and config_file.strip():
        path = Path(config_file).expanduser()
        if not path.is_absolute():
            path = home / path
        return path
    return home / "agents" / f"{name}.toml"


def configured_read_only_agents(home: Path) -> list[dict[str, str]]:
    config = read_toml_file(home / "config.toml")
    agents_table = config.get("agents", {})
    if not isinstance(agents_table, dict):
        return []

    agents: list[dict[str, str]] = []
    seen: set[str] = set()
    for raw_name, spec in agents_table.items():
        name = safe_agent_name(raw_name)
        if not name or name in seen or not isinstance(spec, dict):
            continue

        path = agent_config_path(home, name, spec)
        if not is_relative_to(path, home):
            continue

        agent_config = read_toml_file(path)
        if agent_config.get("sandbox_mode") != "read-only":
            continue

        agents.append(
            {
                "name": name,
                "description": compact_text(spec.get("description")),
            }
        )
        seen.add(name)

    return agents


def classify_agent(agent: dict[str, str]) -> str:
    text = f"{agent['name']} {agent.get('description', '')}".lower()
    if any(
        marker in text
        for marker in (
            "risk",
            "review",
            "regression",
            "security",
            "compatibility",
        )
    ):
        return "review"
    if any(
        marker in text
        for marker in (
            "test",
            "verification",
            "validate",
            "validation",
            "fixture",
            "ci",
        )
    ):
        return "planning"
    return "exploration"


def format_agent_names(names: list[str]) -> str:
    return ", ".join(f"`{name}`" for name in names)


def subagent_context(home: Path) -> str:
    policy = delegation_policy(home)
    if not auto_subagents_enabled(policy):
        return ""

    agents = configured_read_only_agents(home)
    if not agents:
        return ""

    include_descriptions = truthy(policy.get("include_agent_descriptions"))
    exploration_or_planning: list[str] = []
    review: list[str] = []
    lines = [
        "",
        (
            "Local policy asks the main Codex agent to dynamically spawn bounded "
            "read-only helpers when useful; do not wait for "
            "another user prompt."
        ),
        "Available read-only roles:",
    ]
    for agent in agents:
        name = agent["name"]
        if include_descriptions and agent.get("description"):
            lines.append(f"- `{name}`: {agent['description']}")
        else:
            lines.append(f"- `{name}`")

        if classify_agent(agent) == "review":
            review.append(name)
        else:
            exploration_or_planning.append(name)

    role_hint_parts = []
    if exploration_or_planning:
        role_hint_parts.append(
            "exploration/planning: " + format_agent_names(exploration_or_planning)
        )
    if review:
        role_hint_parts.append("review: " + format_agent_names(review))
    if role_hint_parts:
        lines.append("Suggested role timing: " + "; ".join(role_hint_parts) + ".")
    lines.append(
        "Choose the smallest useful set of targeted roles; do not spawn every role by default."
    )
    return "\n".join(lines) + "\n"


def main() -> int:
    payload = read_payload()
    prompt = payload.get("prompt") or ""
    if not looks_complex(prompt):
        return 0

    cwd = payload.get("cwd") or os.getcwd()
    root = resolve_root(cwd)
    home = codex_home()
    state_file = state_file_for_payload(root, payload, home)
    if state_file is None:
        task_state_context = """Durable task-state file: unavailable (hook payload missing session_id)

No session-scoped task-state path is available for this prompt. Continue without
creating a manual fallback path or repo-local state file.
"""
    else:
        try:
            state_status = prepare_state_file(state_file, home=home, create=True)
        except (TaskStateError, OSError):
            task_state_context = """Durable task-state file: unavailable (private initialization failed)

Continue without durable task state for this prompt. Do not create a manual
fallback path or repo-local state file.
"""
            state_file = None
        else:
            state_note = (
                "An empty private task-state scaffold was initialized. Replace it "
                "with a concise rolling summary after initial exploration."
                if state_status == "created"
                else "An existing private task-state file is available; read it when this prompt is a continuation or prior decisions may matter."
            )
            task_state_context = f"""Durable task-state file: `{state_file}`

{state_note}
"""

    related_context = (
        related_task_state_context(root, payload, prompt, home)
        if state_file is not None
        else ""
    )
    context = f"""Global context hint for a complex prompt.

{task_state_context}
{related_context}
Keep raw exploration output out of parent context. Use read-only subagents when
the prompt or local policy request authorizes delegation, tools are exposed,
and active instructions permit it.
Keep current.md summarized; replace stale details instead of appending logs.
This hook does not route SDLC, select workflow skills, create run state, or
inject large documents.
{subagent_context(home)}"""

    print(
        json.dumps(
            {
                "hookSpecificOutput": {
                    "hookEventName": "UserPromptSubmit",
                    "additionalContext": context,
                }
            }
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
