name: ci

on:
  pull_request:
  push:
    tags:
      - "{{project_slug}}-v*"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"
      - name: Install pinned uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.12.9"
      - name: Check lockfile
        run: uv lock --check
      - name: Sync locked environment
        run: uv sync --locked
      - name: Lint
        run: uv run --locked ruff check src tests

  unit-tests:
    runs-on: ubuntu-latest
    needs: lint
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"
      - name: Install pinned uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.12.9"
      - name: Check lockfile
        run: uv lock --check
      - name: Sync locked environment
        run: uv sync --locked
      - name: Fast unit tests
        run: uv run --locked pytest -m "not integration" tests/unit

  build:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    needs: unit-tests
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"
      - name: Install pinned uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.12.9"
      - name: Check lockfile
        run: uv lock --check
      - name: Sync locked environment
        run: uv sync --locked
      - name: Build
        run: uv run --locked python -m build --wheel

  integration-tests:
    if: startsWith(github.ref, 'refs/tags/{{project_slug}}-v') || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    needs: unit-tests
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"
      - name: Install pinned uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.12.9"
      - name: Check lockfile
        run: uv lock --check
      - name: Sync locked environment
        run: uv sync --locked
      - name: Integration tests
        run: uv run --locked pytest -m integration tests/integration

  coverage:
    if: startsWith(github.ref, 'refs/tags/{{project_slug}}-v') || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    needs: unit-tests
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"
      - name: Install pinned uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.12.9"
      - name: Check lockfile
        run: uv lock --check
      - name: Sync locked environment
        run: uv sync --locked
      - name: Coverage
        run: uv run --locked pytest --cov='{{package_name}}' --cov-report=term-missing tests/unit

  packaging:
    if: startsWith(github.ref, 'refs/tags/{{project_slug}}-v') || github.event_name == 'workflow_dispatch'
    runs-on: ubuntu-latest
    needs:
      - integration-tests
      - coverage
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@5fda3b95a4ea91299a34e894583c3862153e4b97 # v7.0.0
        with:
          python-version: "3.12"
      - name: Install pinned uv
        uses: astral-sh/setup-uv@c771a70e6277c0a99b617c7a806ffedaca235ff9 # v9.0.0
        with:
          version: "0.12.9"
      - name: Check lockfile
        run: uv lock --check
      - name: Sync locked environment
        run: uv sync --locked
      - name: Build
        run: uv run --locked python -m build --wheel
