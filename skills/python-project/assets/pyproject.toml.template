[project]
name = "{{project_slug}}"
dynamic = ["version"]
description = "{{short_description}}"
readme = "README.md"
authors = [{ name = "{{author_name}}" }]
requires-python = ">=3.11,<3.14"
license = "Apache-2.0"
license-files = ["LICENSE"]
classifiers = [
  "Programming Language :: Python :: 3",
  "Programming Language :: Python :: 3 :: Only",
]
dependencies = [
  # Add only direct runtime dependencies required by the selected profiles.
]

[project.optional-dependencies]
# Add only consumer-selectable extras. Required application dependencies belong
# in project.dependencies. Example:
# api = [
#   "fastapi>=0.116.0,<1.0.0",
#   "uvicorn[standard]>=0.30.0,<1.0.0",
# ]

[dependency-groups]
dev = [
  "pytest>=9.1.1,<10",
  "pytest-cov>=7.1,<8",
  "pytest-socket>=0.8.1,<0.9",
  # Add pytest-xdist>=3.8,<4 only after measuring a parallelism benefit.
  "ruff>=0.6.0,<1.0.0",
  "mypy>=1.11.0,<2.0.0",
  "build>=1.2.0,<2.0.0",
  "setuptools-scm>=8.0.0,<9.0.0",
  "pip-audit>=2.7.0,<3.0.0",
]

[project.scripts]
{{project_slug}} = "{{package_name}}.__main__:main"

[tool.setuptools]
package-dir = {"" = "src"}

[tool.setuptools.packages.find]
where = ["src"]
include = ["{{package_name}}*"]

[tool.setuptools.package-data]
# For the systemd profile only:
# {{package_name}} = ["systemd/*"]

[tool.setuptools_scm]
version_scheme = "python-simplified-semver"
local_scheme = "no-local-version"
version_file = "src/{{package_name}}/_version.py"
tag_regex = "^{{project_slug}}-v(?P<version>\\d+\\.\\d+\\.\\d+)$"
fallback_version = "0+unknown"
search_parent_directories = true

[tool.setuptools_scm.scm.git]
describe_command = "git describe --dirty --tags --long --abbrev=40 --match {{project_slug}}-v*"

[tool.ruff]
target-version = "py311"
line-length = 100
src = ["src", "tests"]
extend-exclude = ["dist", "build", ".venv", "src/{{package_name}}/_version.py"]

[tool.ruff.lint]
select = ["E", "F", "I", "B", "UP", "SIM"]
ignore = ["B008", "E501"]

[tool.pytest.ini_options]
addopts = [
  "-ra", "--strict-config", "--strict-markers", "--import-mode=importlib",
  "--disable-socket", "-m", "not slow and not e2e and not external",
]
strict_xfail = true
required_plugins = ["pytest-socket>=0.8.1,<0.9"]
markers = [
  "unit: focused behavior with isolated external boundaries",
  "integration: collaboration between real components or controlled dependencies",
  "slow: excluded from the fast feedback lane",
  "external: requires explicit live-test opt-in and target preflight",
  "local_network: permits loopback TCP for a controlled local dependency",
  # Register contract, e2e and smoke when generating those tests.
]
testpaths = ["tests"]

[tool.coverage.run]
branch = true
source = ["{{package_name}}"]

[tool.coverage.report]
skip_empty = true

[build-system]
requires = ["setuptools>=69", "setuptools-scm>=8"]
build-backend = "setuptools.build_meta"
