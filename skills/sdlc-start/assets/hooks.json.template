{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write|mcp__.*|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "SKILLS_AGENT=codex python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/pre_tool_use_sdlc_policy.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SKILLS_AGENT=codex python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/stop_lifecycle_arbiter.py\"",
            "timeout": 30,
            "statusMessage": "Arbitrating workflow completion"
          }
        ]
      }
    ]
  }
}
