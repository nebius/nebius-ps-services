{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/remediation_attempt_guard.py\"",
            "timeout": 30,
            "statusMessage": "Authorizing troubleshoot budget",
            "additionalContextLimit": 800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/remediation_attempt_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking remediation budget"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CODEX_HOME:-$HOME/.codex}/hooks/remediation_attempt_guard.py\"",
            "timeout": 30,
            "statusMessage": "Checking troubleshooting report"
          }
        ]
      }
    ]
  }
}
