{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "implemented"}}},
      "then": {"properties": {"spec_gaps": {"maxItems": 0}}}
    },
    {
      "if": {"properties": {"status": {"const": "replan_required"}}},
      "then": {"properties": {"spec_gaps": {"minItems": 1}}}
    }
  ],
  "properties": {
    "assignment_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "decisions": {"items": {"minLength": 1, "type": "string"}, "type": "array"},
    "open_risks": {"items": {"minLength": 1, "type": "string"}, "type": "array"},
    "review": {"minLength": 1, "type": "string"},
    "spec_gaps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "design_ids": {
            "items": {"pattern": "^FEAT-[0-9]{3,}$", "type": "string"},
            "type": "array",
            "uniqueItems": true
          },
          "evidence": {
            "items": {"minLength": 1, "type": "string"},
            "minItems": 1,
            "type": "array"
          },
          "kind": {"enum": ["requirement", "design", "traceability"]},
          "requirement_ids": {
            "items": {"pattern": "^REQ-[0-9]{3,}$", "type": "string"},
            "type": "array",
            "uniqueItems": true
          },
          "summary": {"minLength": 1, "type": "string"}
        },
        "required": [
          "kind",
          "summary",
          "evidence",
          "requirement_ids",
          "design_ids"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "status": {"enum": ["implemented", "replan_required"]},
    "summary": {"minLength": 1, "type": "string"},
    "task_id": {"pattern": "^TASK-[0-9]{3,}$", "type": "string"},
    "validation": {"minLength": 1, "type": "string"}
  },
  "required": [
    "task_id",
    "assignment_digest",
    "status",
    "summary",
    "decisions",
    "open_risks",
    "spec_gaps",
    "validation",
    "review"
  ],
  "type": "object"
}
